diff --git a/pexpert/arm/pe_fiq.c b/pexpert/arm/pe_fiq.c
index 767c408..10b0310 100644
--- a/pexpert/arm/pe_fiq.c
+++ b/pexpert/arm/pe_fiq.c
@@ -284,6 +284,22 @@ pe_sweet_gic_self_sgi(uint32_t intid)
 	__builtin_arm_isb(ISB_SY);
 }
 
+/*
+ * TargetListFilter = 0b01 (all interfaces except the requesting one). Used
+ * for cross-CPU wakeups: the Exynos CPU-interface numbering does not match
+ * MPIDR Aff0 across clusters, so a CPUTargetList bit would be a guess, while
+ * the broadcast reaches every online core and each one filters the IPI by
+ * its own cpu_signal mask.
+ */
+void
+pe_sweet_gic_broadcast_sgi(uint32_t intid)
+{
+	__builtin_arm_dsb(DSB_ISHST);
+	sweet_gicd_write32(GICD_SGIR,
+	    GICD_SGIR_FILTER_OTHERS | (intid & 0xF));
+	__builtin_arm_isb(ISB_SY);
+}
+
 void
 pe_init_fiq()
 {
