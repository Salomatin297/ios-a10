 			s->release();
 			continue;
 		}
diff --git a/bsd/dev/sweet_emmc.c b/bsd/dev/sweet_emmc.c
index d7d518b..6cc1e28 100644
--- a/bsd/dev/sweet_emmc.c
+++ b/bsd/dev/sweet_emmc.c
@@ -1252,6 +1252,7 @@ emmc_map_controller(void)
 static int sweet_emmc_log_chan;
 static uint64_t sweet_emmc_log_flushed;
 static uint64_t sweet_emmc_log_seq;
+static uint32_t sweet_emmc_log_errors;
 static boolean_t sweet_emmc_log_enabled;
 
 struct sweet_emmc_log_header {
@@ -1388,8 +1389,21 @@ sweet_emmc_log_thread(__unused void *arg, __unused wait_result_t wr)
 		error = sweet_emmc_log_flush();
 		lck_mtx_unlock(&sweet_emmc_lock);
 		if (error) {
-			printf("SWEET LOG: eMMC write failed (%d), stopping\n", error);
-			return;
+			/*
+			 * The boot-time HFS mount occasionally resets the eMMC
+			 * host or leaves a transient R1 error; the first probe
+			 * with the 1125x2436 canvas lost the whole post-launchd
+			 * log because this thread gave up after 20 KiB.  Retry
+			 * forever instead: the persistent log is the only
+			 * observability path on this port.
+			 */
+			if (sweet_emmc_log_errors < 16) {
+				sweet_emmc_log_errors++;
+				printf("SWEET LOG: eMMC write failed (%d), retrying\n",
+				    error);
+			}
+			(void)tsleep(&sweet_emmc_log_chan, PZERO, "sweetlog",
+			    MAX(1, hz / 10));
 		}
 	}
 }
