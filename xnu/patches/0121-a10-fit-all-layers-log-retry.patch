+			int32_t x1 = pdx + pw > (int32_t)fWidth ? (int32_t)fWidth : pdx + pw;
+			int32_t y1 = pdy + ph > (int32_t)fHeight ? (int32_t)fHeight : pdy + ph;
+			if (sw > 0 && sh > 0 && w > 0 && h > 0 && pw > 0 && ph > 0 &&
+			    sx >= 0 && sy >= 0 &&
 			    sw <= (int32_t)s->width - sx && sh <= (int32_t)s->height - sy &&
 			    src != 0 && bpe == 4 && s->memory != NULL &&
