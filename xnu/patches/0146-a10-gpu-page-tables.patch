+/*
+ * Address space 0: a translation table at `transtab` (0 with TRANSCFG
+ * ADRMODE_IDENTITY for physical addresses) and the walker configuration
+ * in `transcfg`.  AS_COMMAND_UPDATE broadcasts the two to the MMU, and
+ * AS_STATUS bit 0 stays set until that is done.
+ */
+static bool
+a10_gpu_as0(vm_offset_t mali, uint64_t transtab, uint32_t transcfg)
+{
+	a10_gpu_write(mali, AS0 + AS_TRANSTAB_LO, (uint32_t)transtab);
+	a10_gpu_write(mali, AS0 + AS_TRANSTAB_HI, (uint32_t)(transtab >> 32));
+	a10_gpu_write(mali, AS0 + AS_TRANSCFG_LO, transcfg);
+	a10_gpu_write(mali, AS0 + AS_TRANSCFG_HI, 0);
+	a10_gpu_write(mali, AS0 + AS_MEMATTR_LO, 0x88888888u);
+	a10_gpu_write(mali, AS0 + AS_MEMATTR_HI, 0x88888888u);
+	a10_gpu_write(mali, AS0 + AS_COMMAND, 1);       /* update */
+	if (!a10_gpu_wait(mali, AS0 + AS_STATUS, 1, 0, 50000)) {
+		printf("A10 GPU: AS0 update timeout, status=%08x\n",
+		    a10_gpu_read(mali, AS0 + AS_STATUS));
+		return false;
+	}
+	return true;
+}
+
+/*
+ * The GPU's page tables: ordinary AArch64 stage-1 tables with 4 KB pages
+ * (AS_TRANSCFG ADRMODE 6), the same shape Linux's Panfrost gives this
+ * hardware.  The A10's MMU reports 48 virtual bits and 40 physical
+ * (MMU_FEATURES 0x2830: VA_BITS = 0x30, PA_BITS = 0x28), so four levels
+ * cover it: bits 47..39, 38..30, 29..21, 20..12.  The walker starts at
+ * the level INA_BITS selects (55 - VA bits, as Panfrost computes it).
+ * A21s's G52 reports 35 bits and uses three levels; that shape is built
+ * as a fallback, so one boot says which one this GPU takes.
+ */
+#define PTE_TABLE           3ull
+#define PTE_PAGE            3ull
+#define PTE_AF              (1ull << 10)
+#define PTE_SH_INNER        (3ull << 8)
+#define PTE_AP_RW           (1ull << 6)
+#define PTE_ADDRESS         0x0000fffffffff000ull
+
+#define TRANSCFG_ADRMODE_AARCH64_4K 6u
+#define TRANSCFG_WALK_WB    (TRANSCFG_ADRMODE_AARCH64_4K | (2u << 24) | \
+			    (1u << 30))		/* walks write-back, read-allocate */
+#define TRANSCFG_48BIT      (TRANSCFG_WALK_WB | (7u << 6))   /* 55 - 48 */
+#define TRANSCFG_35BIT      (TRANSCFG_WALK_WB | (20u << 6))  /* 55 - 35 */
+
+#define A10_GPU_TEST_VA     0x00100000ull
+
+struct a10_gpu_pt {
+	uint64_t *top;
+	uint64_t top_phys;
+	unsigned levels;        /* 4 for a 48-bit VA, 3 for a 35-bit one */
+};
+
+static uint64_t *
+a10_gpu_pt_page(uint64_t *phys)
+{
+	vm_offset_t page = 0;
+
+	if (kmem_alloc(kernel_map, &page, PAGE_SIZE,
+	    KMA_KOBJECT | KMA_ZERO | KMA_DATA,
+	    VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return NULL;
+	}
+	*phys = (uint64_t)kvtophys(page);
+	FlushPoC_DcacheRegion(page, PAGE_SIZE);  /* its zeroes in memory */
+	return (uint64_t *)page;
+}
+
+/* The table below `entry`, made if there is none yet. */
+static uint64_t *
+a10_gpu_pt_below(uint64_t *entry)
+{
+	uint64_t phys;
+	uint64_t *table;
+
+	if (*entry & PTE_TABLE) {
+		return (uint64_t *)phystokv(*entry & PTE_ADDRESS);
+	}
+	table = a10_gpu_pt_page(&phys);
+	if (table == NULL) {
+		return NULL;
+	}
+	*entry = phys | PTE_TABLE;
+	FlushPoC_DcacheRegion((vm_offset_t)entry, sizeof(*entry));
+	return table;
+}
+
+/* One 4 KB page of physical memory at GPU address `gpu`. */
+static bool
+a10_gpu_map(struct a10_gpu_pt *pt, uint64_t gpu, uint64_t phys)
+{
+	uint64_t *table, *entry;
+
+	table = pt->top;
+	if (pt->levels == 4) {
+		table = a10_gpu_pt_below(&table[(gpu >> 39) & 511]);
+		if (table == NULL) {
+			return false;
+		}
+	}
+	table = a10_gpu_pt_below(&table[(gpu >> 30) & 511]);
+	if (table == NULL) {
+		return false;
+	}
+	table = a10_gpu_pt_below(&table[(gpu >> 21) & 511]);
+	if (table == NULL) {
+		return false;
+	}
+	entry = &table[(gpu >> 12) & 511];
+	*entry = (phys & PTE_ADDRESS) | PTE_AF | PTE_SH_INNER | PTE_AP_RW |
+	    PTE_PAGE;
+	FlushPoC_DcacheRegion((vm_offset_t)entry, sizeof(*entry));
+	return true;
+}
