@@ -23,6 +23,11 @@
 
 extern "C" void sweet_secondary_entry(void);
 extern "C" boolean_t sweet_cpu_signal_is_enabled(unsigned int cpu);
+#if defined(SWEET_GICV2)
+/* GIC-400 helpers from pe_fiq.c; also used to retry a lost bring-up SGI. */
+extern "C" void pe_sweet_gic_self_sgi(uint32_t intid);
