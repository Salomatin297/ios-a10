+/*
+ * A timed-out write leaves the card waiting for the rest of the block stream
+ * and the controller owning a FIFO.  Stop the transfer and put both back in a
+ * state where the next request can be tried, otherwise one failure wedges the
+ * eMMC for the rest of the boot.
+ */
+static void
+emmc_abort_data(void)
+{
+	(void)emmc_cmd(12, 0, CMD_STOP_ABORT | RSP_R1B, NULL);
+	(void)emmc_reset_fifo();
+	(void)emmc_wait_not_busy(emmc_deadline(EMMC_READY_NS));
+}
