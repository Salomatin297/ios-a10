+/*
+ * Write-path self-test (emmcwtest=1).  The area right after the 20 GiB HFS
+ * image is not used by the payload, so writing there is safe.  The test
+ * exercises single-block, 18-block (the log flush size) and 128-block
+ * transfers, reads every transfer back, and leaves the card at the last
+ * configuration that passed.
+ */
+static uint8_t
+sweet_emmc_test_byte(uint32_t offset, uint32_t salt)
+{
+	return (uint8_t)(salt ^ (offset * 37u) ^ (offset >> 8));
+}
+
+static int
+sweet_emmc_test_run(uint64_t lba, uint32_t *failed_step, uint32_t *failed_blocks)
+{
+	static const uint32_t counts[] = { 1, 18, 128 };
+	uint32_t step = 1;
+
+	for (unsigned t = 0; t < sizeof(counts) / sizeof(counts[0]); t++) {
+		uint32_t blocks = counts[t];
+		uint32_t bytes = blocks * EMMC_BLOCK_SIZE;
+		uint32_t salt = 0x5a5a0000u ^ (blocks * 0x101u);
+		int error;
+
+		for (uint32_t i = 0; i < bytes; i++) {
+			emmc_bounce[i] = sweet_emmc_test_byte(i, salt);
+		}
+		error = emmc_transfer(lba, blocks, emmc_bounce, true);
+		if (error == 0) {
+			error = emmc_flush_cache();
+		}
+		if (error != 0) {
+			*failed_step = step;
+			*failed_blocks = blocks;
+			return error;
+		}
+		step++;
+
+		bzero(emmc_bounce, bytes);
+		error = emmc_transfer(lba, blocks, emmc_bounce, false);
+		if (error == 0) {
+			for (uint32_t i = 0; i < bytes; i++) {
+				if (emmc_bounce[i] !=
+				    sweet_emmc_test_byte(i, salt)) {
+					printf("SWEET eMMC: selftest mismatch block=%u byte=%u got=%02x want=%02x\n",
+					    blocks, i, emmc_bounce[i],
+					    sweet_emmc_test_byte(i, salt));
+					error = EIO;
+					break;
+				}
+			}
+		}
+		if (error != 0) {
+			*failed_step = step;
+			*failed_blocks = blocks;
+			return error;
+		}
+		printf("SWEET eMMC: selftest %u blocks ok\n", blocks);
+		step++;
+	}
+	return 0;
+}
+
+static void
+sweet_emmc_write_selftest(void)
+{
+	uint64_t lba = se.first_sector + 0x2800200ull;
+	uint32_t failed_step = 0, failed_blocks = 0;
+	int error;
+
+	if (!se.writable) {
+		return;
+	}
+	if (lba + EMMC_MAX_BLOCKS > se.first_sector + se.partition_sectors) {
+		printf("SWEET eMMC: selftest skipped, partition too small\n");
+		return;
+	}
+	sweet_emmc_test_trace = 1;
+	printf("SWEET eMMC: write selftest at LBA 0x%llx, %u-bit, div=%u\n",
+	    lba, se.bus_width, emmc_rd(REG_CLKDIV) & 0xffu);
+	error = sweet_emmc_test_run(lba, &failed_step, &failed_blocks);
+	if (error != 0 && se.bus_width == 8) {
+		printf("SWEET eMMC: selftest 8-bit failed (%d), retrying 1-bit\n",
+		    error);
+		if (emmc_force_one_bit() == 0) {
+			error = sweet_emmc_test_run(lba, &failed_step,
+			    &failed_blocks);
+		} else {
+			printf("SWEET eMMC: selftest 1-bit switch failed\n");
+		}
+	}
+	if (error != 0) {
+		sweet_emmc_test_fail_step = failed_step;
+		sweet_emmc_test_fail_blocks = failed_blocks;
+		sweet_emmc_test_fail_error = error;
+		sweet_emmc_test_failed = 1;
+		printf("SWEET eMMC: SELFTEST FAILED step=%u blocks=%u err=%d stage=%d\n",
+		    failed_step, failed_blocks, error, sweet_emmc_test_stage);
+		printf("SWEET eMMC: SELFTEST st=%08x ri=%08x r1=%08x fcnt=%u done=%u tcb=%08x tbb=%08x\n",
+		    sweet_emmc_test_status, sweet_emmc_test_rintsts,
+		    sweet_emmc_test_r1, sweet_emmc_test_fcnt,
+		    sweet_emmc_test_done, sweet_emmc_test_tcbcnt,
+		    sweet_emmc_test_tbbcnt);
+		panic("SWEET eMMC selftest st=%08x ri=%08x r1=%08x fcnt=%u done=%u tcb=%08x tbb=%08x step=%u blocks=%u err=%d stage=%d",
+		    sweet_emmc_test_status, sweet_emmc_test_rintsts,
+		    sweet_emmc_test_r1, sweet_emmc_test_fcnt,
+		    sweet_emmc_test_done, sweet_emmc_test_tcbcnt,
+		    sweet_emmc_test_tbbcnt, failed_step, failed_blocks, error,
+		    sweet_emmc_test_stage);
+	}
+	printf("SWEET eMMC: write selftest passed, %u-bit\n", se.bus_width);
+	sweet_emmc_test_trace = 0;
+}
