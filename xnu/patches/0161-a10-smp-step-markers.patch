diff --git a/bsd/dev/sweet_emmc.c b/bsd/dev/sweet_emmc.c
index 782a6cb..ab95d44 100644
--- a/bsd/dev/sweet_emmc.c
+++ b/bsd/dev/sweet_emmc.c
@@ -1475,6 +1475,18 @@ sweet_emmc_log_flush_now(const char *tag)
 	}
 }
 
+/*
+ * 0161: synchronous SMP bring-up step marker.  printf() reaches the console
+ * ring; kprintf() does not.  The flush puts the line on the eMMC before the
+ * next step can wedge the boot core.
+ */
+void
+sweet_emmc_step(const char *tag)
+{
+	printf("SWEET STEP: %s\n", tag);
+	sweet_emmc_log_flush_now(tag);
+}
+
 static bool sweet_emmc_brought_up;
 
 /*
diff --git a/iokit/Kernel/arm/SweetCPU.cpp b/iokit/Kernel/arm/SweetCPU.cpp
index e6e7995..b343b7e 100644
--- a/iokit/Kernel/arm/SweetCPU.cpp
+++ b/iokit/Kernel/arm/SweetCPU.cpp
@@ -29,6 +29,7 @@ extern "C" int sweet_emmc_early_init(void);
 extern "C" void sweet_emmc_log_flush_now(const char *tag);
 /* osfmk/kern/waitq.c: global waitq table health, the 4-core panic suspect. */
 extern "C" void sweet_wq_check(const char *tag);
+extern "C" void sweet_emmc_step(const char *tag);
 extern "C" unsigned int sweet_wq_bad_count(void);
 #if defined(SWEET_GICV2)
 /* GIC-400 helpers from pe_fiq.c; also used to retry a lost bring-up SGI. */
@@ -645,6 +646,7 @@ kern_return_t
 SweetCPU::startCPU(vm_offset_t start_paddr, vm_offset_t arg_paddr)
 {
 	const ml_topology_cpu_t *cpu = &ml_get_topology_info()->cpus[getCPUNumber()];
+	sweet_emmc_step("startCPU: enter");
 	/*
 	 * cpu_start() passes NULL,NULL: x20/x21 are set by LowResetVectorBase.
 	 * The boot core is MPIDR 0x100, so phys_id 0 is a real secondary
@@ -658,13 +660,16 @@ SweetCPU::startCPU(vm_offset_t start_paddr, vm_offset_t arg_paddr)
 	IOLog("SWEET CPU: cpu=%u CPU_ON target=0x%x entry_pa=0x%llx context=%u\n",
 	    getCPUNumber(), cpu->phys_id, (uint64_t)entry, getCPUNumber());
 	__builtin_arm_dsb(DSB_SY);
+	sweet_emmc_step("startCPU: pre-smc");
 	int32_t rc = sweet_psci_cpu_on(cpu->phys_id, entry, getCPUNumber());
 	first_psci_rc = last_psci_rc = rc;
+	sweet_emmc_step("startCPU: post-smc");
 	IOLog("SWEET CPU: cpu=%u PSCI CPU_ON rc=%d\n", getCPUNumber(), rc);
 	/* cpu_start() discards PE_cpu_start's return; do not silently carry on. */
 	if (rc != 0) {
 		panic("SWEET CPU: cpu=%u NOT alive: PSCI CPU_ON rc=%d", getCPUNumber(), rc);
 	}
+	sweet_emmc_step("startCPU: done");
 	return KERN_SUCCESS;
 }
 
