diff --git a/bsd/dev/a10_keys.c b/bsd/dev/a10_keys.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/a10_keys.c
@@ -0,0 +1,196 @@
+/*
+ * A10 (Exynos 7884B) GPIO buttons.
+ *
+ * The Galaxy A10 wires power, volume-up and volume-down to GPA1.7, GPA1.5
+ * and GPA1.6, all active low and all described by /gpio_keys in the live
+ * device tree.  The bootloader leaves them muxed as EINT; Exynos still
+ * exposes the pin level in the bank's DAT register, but the stock Linux
+ * gpio-keys driver selects the plain input function, so do the same unless
+ * a10keys_keepmux=1 is supplied.
+ *
+ * Polling only: no interrupts, no PMIC writes, no wake configuration.
+ * Call once after the scheduler is running.  a10keys=0 disables the driver.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern void sweet_hid_key(int key, int down);
+void a10_keys_init(void);
+
+#define A10_GPIO_PA       0x11cb0000u
+#define A10_GPIO_SIZE     0x1000u
+#define A10_GPA1_CON      0x060u
+#define A10_GPA1_DAT      0x064u
+
+#define A10_KEYS_POLL_MS  20
+#define A10_KEYS_STABLE   2
+
+struct a10_key {
+	unsigned pin;
+	int key;
+	const char *name;
+};
+
+/* sweet_hid_key(): 0 power, 1 volume up, 2 volume down. */
+static const struct a10_key a10_keys[] = {
+	{ 7, 0, "power" },
+	{ 5, 1, "volup" },
+	{ 6, 2, "voldown" },
+};
+
+static vm_offset_t a10_gpio;
+static bool a10_keys_started;
+static int a10_keys_chan;
+static int a10_keys_debug;
+
+static uint32_t
+a10_rd(uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(a10_gpio + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+a10_wr(uint32_t off, uint32_t val)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(a10_gpio + off) = val;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static void
+a10_keys_wait(void)
+{
+	uint64_t deadline;
+
+	clock_interval_to_deadline(A10_KEYS_POLL_MS, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&a10_keys_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static void
+a10_keys_mux_input(void)
+{
+	uint32_t con = a10_rd(A10_GPA1_CON);
+	uint32_t next = con;
+	bool changed = false;
+
+	for (unsigned i = 0; i < sizeof(a10_keys) / sizeof(a10_keys[0]); ++i) {
+		unsigned shift = a10_keys[i].pin * 4u;
+		uint32_t old = (con >> shift) & 0xfu;
+		if (old != 0u) {
+			next &= ~(0xfu << shift); /* function 0 = input */
+			changed = true;
+		}
+	}
+	if (changed) {
+		a10_wr(A10_GPA1_CON, next);
+		printf("A10 KEYS: GPA1 CON %08x -> %08x (input mux)\n", con,
+		    a10_rd(A10_GPA1_CON));
+	} else {
+		printf("A10 KEYS: GPA1 CON already input (%08x)\n", con);
+	}
+}
+
+static bool
+a10_keys_pressed(uint32_t dat, unsigned i)
+{
+	return ((dat >> a10_keys[i].pin) & 1u) == 0u;
+}
+
+static void
+a10_keys_thread(void *arg, wait_result_t result)
+{
+	int stable[sizeof(a10_keys) / sizeof(a10_keys[0])];
+	int candidate[sizeof(a10_keys) / sizeof(a10_keys[0])];
+	int count[sizeof(a10_keys) / sizeof(a10_keys[0])];
+	uint32_t dat = a10_rd(A10_GPA1_DAT);
+
+	(void)arg;
+	(void)result;
+	for (unsigned i = 0; i < sizeof(a10_keys) / sizeof(a10_keys[0]); ++i) {
+		stable[i] = a10_keys_pressed(dat, i) ? 1 : 0;
+		candidate[i] = stable[i];
+		count[i] = 0;
+	}
+	printf("A10 KEYS: polling GPA1 DAT=%08x, initial power=%d volup=%d "
+	    "voldown=%d\n", dat, stable[0], stable[1], stable[2]);
+
+	for (;;) {
+		dat = a10_rd(A10_GPA1_DAT);
+		for (unsigned i = 0; i < sizeof(a10_keys) / sizeof(a10_keys[0]); ++i) {
+			int now = a10_keys_pressed(dat, i) ? 1 : 0;
+			if (now == stable[i]) {
+				candidate[i] = now;
+				count[i] = 0;
+				continue;
+			}
+			if (now != candidate[i]) {
+				candidate[i] = now;
+				count[i] = 1;
+			} else if (count[i] < A10_KEYS_STABLE) {
+				count[i]++;
+			}
+			if (count[i] >= A10_KEYS_STABLE) {
+				stable[i] = now;
+				count[i] = 0;
+				printf("A10 KEYS: %s %s (DAT=%08x)\n",
+				    a10_keys[i].name, now ? "down" : "up", dat);
+				sweet_hid_key(a10_keys[i].key, now);
+			}
+		}
+		if (a10_keys_debug) {
+			static unsigned ticks;
+			if (++ticks >= 3000u) { /* one minute at 20 ms */
+				ticks = 0;
+				printf("A10 KEYS: heartbeat DAT=%08x\n", dat);
+			}
+		}
+		a10_keys_wait();
+	}
+}
+
+void
+a10_keys_init(void)
+{
+	int enabled = 1;
+	int keepmux = 0;
+	thread_t thread;
+	kern_return_t kr;
+
+	if (a10_keys_started) {
+		return;
+	}
+	a10_keys_started = true;
+	(void)PE_parse_boot_argn("a10keys", &enabled, sizeof(enabled));
+	(void)PE_parse_boot_argn("a10keys_keepmux", &keepmux, sizeof(keepmux));
+	(void)PE_parse_boot_argn("a10keys_debug", &a10_keys_debug,
+	    sizeof(a10_keys_debug));
+	if (!enabled) {
+		printf("A10 KEYS: disabled (a10keys=0)\n");
+		return;
+	}
+	a10_gpio = ml_io_map(A10_GPIO_PA, A10_GPIO_SIZE);
+	if (a10_gpio == 0) {
+		printf("A10 KEYS: pinctrl MMIO mapping failed\n");
+		return;
+	}
+	if (!keepmux) {
+		a10_keys_mux_input();
+	}
+	kr = kernel_thread_start(a10_keys_thread, NULL, &thread);
+	if (kr == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("A10 KEYS: kernel_thread_start failed %d\n", kr);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
