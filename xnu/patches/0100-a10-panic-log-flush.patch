+/*
+ * Write the console bytes that have not reached the eMMC yet.  The caller
+ * holds sweet_emmc_lock.  Returns an errno or 0.
+ */
+static int
+sweet_emmc_log_flush(void)
+{
+	uint64_t base = se.first_sector + se.partition_sectors - SWEET_EMMC_LOG_SECTORS;
+	uint64_t total = sweet_log_position();
+	uint64_t window = total > SWEET_EMMC_LOG_SIZE ?
+	    total - SWEET_EMMC_LOG_SIZE : 0;
+	uint64_t pos = sweet_emmc_log_flushed > window ?
+	    sweet_emmc_log_flushed : window;
+	int error = 0;
+
+	if (total == sweet_emmc_log_flushed) {
+		return 0;
+	}
+	while (pos < total && !error) {
+		uint32_t off = (uint32_t)(pos % SWEET_EMMC_LOG_SIZE);
+		uint32_t blk = off / EMMC_BLOCK_SIZE;
+		uint32_t skip = off % EMMC_BLOCK_SIZE;
+		uint64_t need = (skip + (total - pos) + EMMC_BLOCK_SIZE - 1) /
+		    EMMC_BLOCK_SIZE;
+		uint32_t n = (uint32_t)MIN(MIN(need,
+		    (uint64_t)(SWEET_EMMC_LOG_BLOCKS - blk)),
+		    (uint64_t)(EMMC_MAX_XFER / EMMC_BLOCK_SIZE));
+		uint32_t want = (uint32_t)MIN(total - pos,
+		    (uint64_t)n * EMMC_BLOCK_SIZE - skip);
+		uint64_t copy = pos;
+
+		bzero(emmc_bounce, n * EMMC_BLOCK_SIZE);
+		(void)sweet_log_copy(&copy, (char *)emmc_bounce + skip, want);
+		error = emmc_transfer(base + 1 + blk, n, emmc_bounce, true);
+		pos += want;
+	}
+	if (!error) {
+		struct sweet_emmc_log_header h = {
+			.magic = { 'S', 'W', 'E', 'E', 'T', 'L', 'O', 'G' },
+			.version = 1, .size = SWEET_EMMC_LOG_SIZE,
+			.total = total, .seq = ++sweet_emmc_log_seq,
+		};
+
+		bzero(emmc_bounce, EMMC_BLOCK_SIZE);
+		memcpy(emmc_bounce, &h, sizeof(h));
+		error = emmc_transfer(base, 1, emmc_bounce, true);
+	}
+	if (!error) {
+		error = emmc_flush_cache();
+	}
+	if (!error) {
+		sweet_emmc_log_flushed = total;
+	}
+	return error;
+}
+
+/*
+ * Panic-path flush: called with the scheduler stopped and interrupts off.
+ * try_lock because a panic can happen while this CPU already holds the
+ * lock (in the log thread itself) and there is no other CPU to wait for.
+ */
+void
+sweet_emmc_log_sync(void)
+{
+	int error;
+
+	if (!sweet_emmc_log_enabled || !se.writable) {
+		return;
+	}
+	if (!lck_mtx_try_lock(&sweet_emmc_lock)) {
+		return;
+	}
+	error = sweet_emmc_log_flush();
+	lck_mtx_unlock(&sweet_emmc_lock);
+	if (error) {
+		printf("SWEET LOG: panic flush failed (%d)\n", error);
+	}
+}
