+/*
+ * Bring-up diagnostics: the first transfer failures are printed with the
+ * parameters that the block layer asked for, so a launchd exec ETIMEDOUT can
+ * be attributed to a specific LBA/size instead of guessing.
+ */
+static int sweet_emmc_error_logs;
+
+static void
+sweet_emmc_log_error(const char *what, uint64_t lba, uint32_t blocks,
+    int write, int error)
+{
+	if (sweet_emmc_error_logs >= 16) {
+		return;
+	}
+	if (sweet_emmc_error_logs++ == 0) {
+		printf("SWEET eMMC: logging the first I/O failures\n");
+	}
+	printf("SWEET eMMC: %s lba=0x%llx blocks=%u %s -> %d\n", what,
+	    lba, blocks, write ? "write" : "read", error);
+}
