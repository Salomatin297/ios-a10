diff --git a/osfmk/arm/arm_init.c b/osfmk/arm/arm_init.c
index a5d0cd9..0eb4da9 100644
--- a/osfmk/arm/arm_init.c
+++ b/osfmk/arm/arm_init.c
@@ -358,6 +358,16 @@ arm_init(
 	unsigned int dt_entry_size = 0;
 
 	sweet_early_mark(1, "arm_init entered (MMU on)");
+	/* 0163: boot_args values before the persistent log exists.  The
+	 * hole list is read through the bootstrap V=P mapping, so its PA
+	 * is a valid address here. */
+	sweet_early_hex("memSize", args->memSize);
+	sweet_early_hex("memActual", args->memSizeActual);
+	sweet_early_hex("physBase", args->physBase);
+	sweet_early_hex("virtBase", args->virtBase);
+	sweet_early_hex("topKernel", args->topOfKernelData);
+	sweet_early_hex("holeMagic", *(volatile uint64_t *)(uintptr_t)
+	    (args->topOfKernelData - 0x2000));
 
 	arm_setup_pre_sign();
 
diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index 87b1ab2..2c72278 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -740,26 +740,38 @@ Lkernelcache_base_found:
 
 #if defined(SWEET)
 	/*
-	 * Splash framebuffer: 32MB of Normal-NC in the EXISTING V=P L2
-	 * table. Both framebuffer and RAM use L1 index 0; another call to
-	 * create_bootstrap_mapping would replace the RAM L2 table. All
-	 * bring-up RAM (and the fb) is below 4GB, so the first V=P L2 page
-	 * is bootstrap_pagetables + 2*PGBYTES.
+	 * Splash framebuffer: 20MB of Normal-NC in the EXISTING V=P L2
+	 * table that owns the framebuffer VA. Another call to
+	 * create_bootstrap_mapping would replace the RAM L2 table, so add
+	 * the block entries directly.
+	 *
+	 * The L2 table is located through the V=P L1 entry instead of a
+	 * fixed page offset: which V=P L2 page covers 0xEC000000 depends
+	 * on phys_base. With the old 0xC4000000 layout the fb fell into
+	 * the first L2 page (L1 index 3); with the A10 full-RAM layout
+	 * (phys_base 0x80000000) the V=P mapping starts at L1 index 2 and
+	 * the fb is in the second L2 page. The old hardcoded
+	 * bootstrap_pagetables + 2*PGBYTES then mapped 0xAC000000 over
+	 * the framebuffer PA and left 0xEC000000 unmapped, so the first
+	 * sweet_early_mark() took a translation fault.
 	 *
 	 * Granularity-agnostic (a10 patch 0083): an L2 block covers 32MB
 	 * with 16K pages but only 2MB with the 4K pages the A10 ARMv8.0
-	 * cores require, so the TTE loop stores (0x02000000 >>
-	 * ARM_TT_L2_SHIFT) entries — 16 or 1 — starting at the entry that
-	 * maps 0x9c000000. Attrs live all below the block-granularity bits
+	 * cores require, so the TTE loop stores (0x01400000 >>
+	 * ARM_TT_L2_SHIFT) entries — 10 or 1 — starting at the entry that
+	 * maps 0xEC000000. Attrs live all below the block-granularity bits
 	 * and the high NX/PNX bits are far above any two-bit carry reach,
 	 * so adding the block size to the TTE value steps the PA field
 	 * without touching them.
 	 */
 	MOV64	x10, 0xEC000000			/* a10 patch 0085: SBOOT fb (was Redmi 0x9c000000) */
 	MOV64	x11, (ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID | ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX)
+	and		x12, x10, #(ARM_TT_L1_INDEX_MASK)
+	lsr		x12, x12, #(ARM_TT_L1_SHIFT)
+	ldr		x13, [x25, x12, lsl #TTE_SHIFT]	/* V=P L1 entry -> L2 table PA */
+	and		x13, x13, #(ARM_TTE_TABLE_MASK)
 	and		x12, x10, #(ARM_TT_L2_INDEX_MASK)
 	lsr		x12, x12, #(ARM_TT_L2_SHIFT)
-	add		x13, x25, #(2 * PGBYTES)
 	add		x13, x13, x12, lsl #TTE_SHIFT
 	orr		x11, x11, x10
 	MOV64	x12, ((0x01400000 + (1 << ARM_TT_L2_SHIFT) - 1) >> ARM_TT_L2_SHIFT)	/* 20MB fb reserve, rounded up to L2 blocks */
diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
index 6514354..5fdfeb2 100644
--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -86,6 +86,23 @@ sweet_early_string(const char *s)
 	}
 }
 
+/* 0163: on-screen value dump for the pre-log part of the boot. */
+void
+sweet_early_hex(const char *label, uint64_t value)
+{
+	if (early_disabled) {
+		return;
+	}
+	sweet_early_string(label);
+	sweet_early_putc('=');
+	sweet_early_string("0x");
+	for (int shift = 60; shift >= 0; shift -= 4) {
+		unsigned int d = (unsigned int)((value >> shift) & 0xf);
+		sweet_early_putc((char)(d < 10 ? '0' + d : 'a' + d - 10));
+	}
+	sweet_early_putc('\n');
+}
+
 void
 sweet_early_mark(unsigned int stage, const char *label)
 {
