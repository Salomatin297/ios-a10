diff --git a/osfmk/arm/pmap/pmap.c b/osfmk/arm/pmap/pmap.c
index 9d4f2f2..a6b42b3 100644
--- a/osfmk/arm/pmap/pmap.c
+++ b/osfmk/arm/pmap/pmap.c
@@ -2576,6 +2576,10 @@ pmap_virtual_region(
  * need to skip those pages.
  */
 
+#if defined(SWEET)
+extern pmap_paddr_t sweet_hole_skip(pmap_paddr_t pa);
+#endif
+
 static unsigned int avail_page_count = 0;
 static bool need_ram_ranges_init = true;
 
@@ -2640,6 +2644,16 @@ pmap_next_page_hi(
 	ppnum_t            * pnum,
 	__unused boolean_t might_free)
 {
+#if defined(SWEET)
+	/* pmap_steal_memory()'s pages skip the holes; pmap_startup() handles
