diff --git a/bsd/dev/a10_audio.c b/bsd/dev/a10_audio.c
new file mode 100644
index 0000000..114ea11
--- /dev/null
+++ b/bsd/dev/a10_audio.c
@@ -0,0 +1,166 @@
+/*
+ * A10 (Exynos 7884B): audio block bring-up, step 1 (diagnostics only).
+ *
+ * The A10 audio path is not an I2S plus a simple codec:
+ *
+ *   ABOX     0x14A50000  Samsung audio block with its own GIC (0x14af1000)
+ *                         and an IOMMU (sysmmu_abox, IRQ 129); it carries
+ *                         the audio stream routing and 4 MiB of reserved
+ *                         memory at 0xE9400000 for the AOP side.
+ *   SPEEDY   0x11CE0000  peripheral bus (samsung,exynos-speedy, IRQ 34) that
+ *                         carries the codec; the COD3035X sits on it as
+ *                         device 0x03.
+ *   CODEC    COD3035X    headphone/speaker codec, reached through SPEEDY.
+ *
+ * This file only probes: it opens the SPEEDY clock through the APM block,
+ * maps SPEEDY and dumps its registers (including the IP batcher state).
+ * Nothing is configured, no DMA is started and no interrupt is claimed, so
+ * it cannot disturb the running system.  The point is to learn whether the
+ * audio hardware answers at all, which decides whether the next steps (codec
+ * programming, then an "AOP audio" IOKit service for the stock
+ * AppleAOPAudioPlugin HAL) are worth building.
+ *
+ * Enabled with the boot argument a10audio=1; off by default so the SMP
+ * probes are unaffected.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+
+/*
+ * APM SFR block (cmucal-sfr-7885.c: SFR_BLOCK(APM, 0x11c00000, 0x8000)).
+ * The SPEEDY gate and Q-channel live here, not in CMU_PERI: the DT clock is
+ * <&cmus 0x133>, and that index is not a register offset.  The previous probe
+ * used CMU_PERI + 0x2038 + 4*0x133 and died on an external abort at
+ * 0x100134e4, which is what this file fixes.
+ */
+#define A10_APM_PA          0x11c00000u
+#define A10_APM_SIZE        0x8000u
+#define A10_APM_SPEEDY_GATE 0x2064u
+#define A10_APM_SPEEDY_QCH  0x304cu
+#define A10_GATE_MANUAL     (1u << 20)
+#define A10_GATE_CG_VAL     (1u << 21)
+#define A10_QCH_ENABLE      (1u << 0)
+#define A10_QCH_REQ         (1u << 1)
+
+#define A10_SPEEDY_PA       0x11ce0000u
+#define A10_SPEEDY_SIZE     0x2000u
+
+/* SPEEDY registers (drivers/i2c/busses/i2c-speedy.c). */
+#define SPEEDY_CTRL          0x000u
+#define SPEEDY_FIFO_CTRL     0x004u
+#define SPEEDY_CMD           0x008u
+#define SPEEDY_INT_ENABLE    0x00cu
+#define SPEEDY_INT_STATUS    0x010u
+#define SPEEDY_FIFO_STATUS   0x030u
+#define SPEEDY_TX_DATA       0x034u
+#define SPEEDY_RX_DATA       0x038u
+#define SPEEDY_PACKET_GAP    0x044u
+#define SPEEDY_TIMEOUT_COUNT 0x048u
+#define SPEEDY_CTRL_STATUS   0x104u
+
+/* IP batcher registers; the codec is only reachable through this engine. */
+#define IPBATCHER_CON        0x500u
+#define IPBATCHER_STATE      0x504u
+#define IPBATCHER_INT_EN     0x508u
+#define IP_FIFO_STATUS       0x51cu
+#define IP_INT_STATUS        0x520u
+
+static vm_offset_t a10_apm;
+static vm_offset_t a10_speedy;
+static bool a10_audio_ready;
+
+static inline uint32_t
+a10_apm_read(unsigned off)
+{
+	return *(volatile uint32_t *)(a10_apm + off);
+}
+
+static inline void
+a10_apm_write(unsigned off, uint32_t val)
+{
+	*(volatile uint32_t *)(a10_apm + off) = val;
+}
+
+static inline uint32_t
+a10_speedy_read(unsigned off)
+{
+	return *(volatile uint32_t *)(a10_speedy + off);
+}
+
+/*
+ * Open the SPEEDY clock.  The gate has a manual/cg-value pair that forces
+ * the PCLK on; the Q-channel then sees the requests from the IP.  The
+ * register offsets come from cmucal-sfr-7885.c, not from the DT clock index.
+ */
+static void
+a10_audio_ungate(void)
+{
+	uint32_t before, after;
+
+	before = a10_apm_read(A10_APM_SPEEDY_QCH);
+	after = before | A10_QCH_ENABLE | A10_QCH_REQ;
+	a10_apm_write(A10_APM_SPEEDY_QCH, after);
+	printf("A10 AUDIO: speedy qch %08x -> %08x (now %08x)\n",
+	    before, after, a10_apm_read(A10_APM_SPEEDY_QCH));
+
+	before = a10_apm_read(A10_APM_SPEEDY_GATE);
+	after = before | A10_GATE_MANUAL | A10_GATE_CG_VAL;
+	a10_apm_write(A10_APM_SPEEDY_GATE, after);
+	printf("A10 AUDIO: speedy gate %08x -> %08x (now %08x)\n",
+	    before, after, a10_apm_read(A10_APM_SPEEDY_GATE));
+}
+
+int
+a10_audio_init(void)
+{
+	int enabled = 0;
+
+	if (!PE_parse_boot_argn("a10audio", &enabled, sizeof(enabled)) ||
+	    enabled != 1) {
+		return ENXIO;
+	}
+	if (a10_audio_ready) {
+		return 0;
+	}
+
+	a10_apm = ml_io_map(A10_APM_PA, A10_APM_SIZE);
+	if (a10_apm == 0) {
+		printf("A10 AUDIO: cannot map APM\n");
+		return ENXIO;
+	}
+	a10_audio_ungate();
+
+	a10_speedy = ml_io_map(A10_SPEEDY_PA, A10_SPEEDY_SIZE);
+	if (a10_speedy == 0) {
+		printf("A10 AUDIO: cannot map SPEEDY\n");
+		return ENXIO;
+	}
+	printf("A10 AUDIO: SPEEDY ctrl=%08x fifo_ctrl=%08x cmd=%08x "
+	    "int_en=%08x int_status=%08x\n",
+	    a10_speedy_read(SPEEDY_CTRL), a10_speedy_read(SPEEDY_FIFO_CTRL),
+	    a10_speedy_read(SPEEDY_CMD), a10_speedy_read(SPEEDY_INT_ENABLE),
+	    a10_speedy_read(SPEEDY_INT_STATUS));
+	printf("A10 AUDIO: SPEEDY fifo_status=%08x pkt_gap=%08x timeout=%08x "
+	    "ctrl_status=%08x\n",
+	    a10_speedy_read(SPEEDY_FIFO_STATUS),
+	    a10_speedy_read(SPEEDY_PACKET_GAP),
+	    a10_speedy_read(SPEEDY_TIMEOUT_COUNT),
+	    a10_speedy_read(SPEEDY_CTRL_STATUS));
+	printf("A10 AUDIO: batcher con=%08x state=%08x int_en=%08x "
+	    "fifo=%08x int_status=%08x\n",
+	    a10_speedy_read(IPBATCHER_CON), a10_speedy_read(IPBATCHER_STATE),
+	    a10_speedy_read(IPBATCHER_INT_EN), a10_speedy_read(IP_FIFO_STATUS),
+	    a10_speedy_read(IP_INT_STATUS));
+
+	a10_audio_ready = true;
+	printf("A10 AUDIO: probe done (APM gate + SPEEDY registers)\n");
+	return 0;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
