+/*
+ * PSCI 0.2+ system calls.  The A10 device tree advertises the PSCI 0.1
+ * cpu_suspend/off/on IDs over SMC, so SYSTEM_OFF may be unsupported on
+ * this firmware; the PMU path below is then authoritative.
+ */
+static int32_t
+a10_psci_call(uint64_t fn)
+{
+	register uint64_t x0 __asm__("x0") = fn;
+
+	__asm__ volatile("smc #0" : "+r"(x0) : :
+	    "x1", "x2", "x3", "x4", "x5", "x6", "x7", "x8", "x9", "x10",
+	    "x11", "x12", "x13", "x14", "x15", "x16", "x17", "cc", "memory");
+	return (int32_t)x0;
+}
+
+static void
+a10_power_off(void)
+{
+	int32_t ret;
+
+	printf("A10 KEYS: power off requested, trying PSCI SYSTEM_OFF\n");
+	ret = a10_psci_call(0x84000008u);
+	printf("A10 KEYS: PSCI SYSTEM_OFF returned %d\n", ret);
+
+	/* Same sequence as the stock kernel's pm_power_off: PS_HOLD low. */
+	{
+		vm_offset_t pmu = a10_pmu;
+
+		if (pmu == 0) {
+			/* Early panic before a10_keys_init(): map on demand. */
+			pmu = ml_io_map(A10_PMU_PA, A10_PMU_SIZE);
+		}
+		if (pmu != 0) {
+			uint32_t v = *(volatile uint32_t *)(pmu + A10_PMU_PS_HOLD);
+			uint32_t next = v & ~A10_PMU_PS_HOLD_EN;
+
+			printf("A10 KEYS: PS_HOLD %08x -> %08x\n", v, next);
+			__asm__ volatile("dmb oshst" ::: "memory");
+			*(volatile uint32_t *)(pmu + A10_PMU_PS_HOLD) = next;
+			__asm__ volatile("dsb osh" ::: "memory");
+		} else {
+			printf("A10 KEYS: PMU MMIO mapping failed\n");
+		}
+	}
+
+	ret = a10_psci_call(0x84000009u);
+	printf("A10 KEYS: PSCI SYSTEM_RESET returned %d\n", ret);
+	if (ret != 0) {
+		printf("A10 KEYS: power off failed, still running\n");
+	}
+}
+
+/*
+ * Called from panic_spin_forever() on the panicking CPU, with the scheduler
+ * stopped and interrupts off.  Busy-polls the power key and powers the SoC
+ * off when it is held.  Returns TRUE if this iteration was consumed (the
+ * poll interval is included), FALSE when the caller should WFE as usual.
+ */
+boolean_t
+a10_keys_panic_poll(void)
+{
+	static unsigned hold;
+	uint32_t dat;
+
+	if (a10_gpio == 0 || a10_power_hold_ms <= 0) {
+		return FALSE;
+	}
+	dat = a10_rd(A10_GPA1_DAT);
+	if (a10_keys_pressed(dat, 0)) {
+		unsigned need = (unsigned)(a10_power_hold_ms + A10_KEYS_POLL_MS - 1) /
+		    A10_KEYS_POLL_MS;
+		if (++hold >= need) {
+			printf("A10 KEYS: panic, power held %d ms, shutting down\n",
+			    a10_power_hold_ms);
+			hold = 0;
+			a10_power_off();
+		}
+	} else {
+		hold = 0;
+	}
+	delay(A10_KEYS_POLL_MS * 1000);
+	return TRUE;
+}
