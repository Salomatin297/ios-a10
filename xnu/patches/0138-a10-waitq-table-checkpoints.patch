+/*
+ * A10 SMP bring-up diagnostic.
+ *
+ * The 4-core panic leaves the whole global waitq hash table zeroed except
+ * the first few elements, although waitq_bootstrap() initializes every
+ * element and the table is never freed.  These helpers are called at the
+ * CPU_ON boundaries (SweetCPU.cpp) and from the persistent-log thread, so
+ * the log shows the first checkpoint at which the table is already bad and
+ * the raw bytes around the first damaged element.
+ *
+ * Only the embedded ticket lock is inspected: lck_type and lck_valid are
+ * written once by waitq_init() and never change afterwards.
+ */
+unsigned int
+sweet_wq_bad_count(void)
+{
+	uint32_t bad = 0;
+
+	if (global_waitqs == &g_boot_waitq || g_num_waitqs == 0 ||
+	    g_num_waitqs > 512) {
+		return 0;
+	}
+	for (uint32_t i = 0; i < g_num_waitqs; i++) {
+		hw_lck_ticket_t *l = &global_waitqs[i].waitq_interlock;
+
+		if (l->lck_type != LCK_TYPE_TICKET || !l->lck_valid) {
+			bad++;
+		}
+	}
+	return bad;
+}
+
+static uint64_t
+sweet_wq_raw(uint32_t index, uint32_t word)
+{
+	if (index >= g_num_waitqs) {
+		return 0;
+	}
+	return ((const volatile uint64_t *)&global_waitqs[index])[word];
+}
+
+void
+sweet_wq_check(const char *tag)
+{
+	uint64_t valid[8] = { 0 };
+	uint32_t bad = 0;
+	long first = -1;
+	uint32_t foff = 0;
+	uint64_t pa = 0;
+
+	if (global_waitqs == &g_boot_waitq || g_num_waitqs == 0 ||
+	    g_num_waitqs > 512) {
+		printf("SWEET WQCHK: %s pre-bootstrap num=%u\n", tag,
+		    g_num_waitqs);
+		return;
+	}
+	for (uint32_t i = 0; i < g_num_waitqs; i++) {
+		hw_lck_ticket_t *l = &global_waitqs[i].waitq_interlock;
+
+		if (l->lck_type == LCK_TYPE_TICKET && l->lck_valid) {
+			valid[i >> 6] |= 1ull << (i & 63);
+		} else {
+			if (first < 0) {
+				first = (long)i;
+				foff = (uint32_t)((uintptr_t)l -
+				    (uintptr_t)global_waitqs);
+			}
+			bad++;
+		}
+	}
+#if defined(__arm64__)
+	if (bad != 0) {
+		pa = sweet_wq_table_pa();
+	}
+#endif
+	printf("SWEET WQCHK: %s bad=%u/%u first=%ld foff=%u pa=%llx "
+	    "valid=%llx,%llx,%llx,%llx,%llx,%llx,%llx,%llx "
+	    "e0=%llx,%llx,%llx e5=%llx,%llx,%llx e6=%llx,%llx,%llx\n",
+	    tag, bad, g_num_waitqs, first, foff, (unsigned long long)pa,
+	    (unsigned long long)valid[0], (unsigned long long)valid[1],
+	    (unsigned long long)valid[2], (unsigned long long)valid[3],
+	    (unsigned long long)valid[4], (unsigned long long)valid[5],
+	    (unsigned long long)valid[6], (unsigned long long)valid[7],
+	    (unsigned long long)sweet_wq_raw(0, 0),
+	    (unsigned long long)sweet_wq_raw(0, 1),
+	    (unsigned long long)sweet_wq_raw(0, 2),
+	    (unsigned long long)sweet_wq_raw(5, 0),
+	    (unsigned long long)sweet_wq_raw(5, 1),
+	    (unsigned long long)sweet_wq_raw(5, 2),
+	    (unsigned long long)sweet_wq_raw(6, 0),
+	    (unsigned long long)sweet_wq_raw(6, 1),
+	    (unsigned long long)sweet_wq_raw(6, 2));
+}
+
