+/* Size the framebuffer reports to userland; HID uses the same space. */
+static uint32_t sweet_fb_logical_w;
+static uint32_t sweet_fb_logical_h;
+
+extern "C" bool
+sweet_fb_get_logical_size(uint32_t *w, uint32_t *h)
+{
+	if (sweet_fb_logical_w == 0 || sweet_fb_logical_h == 0) {
+		return false;
+	}
+	*w = sweet_fb_logical_w;
+	*h = sweet_fb_logical_h;
+	return true;
+}
 
