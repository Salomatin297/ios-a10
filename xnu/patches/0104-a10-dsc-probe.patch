diff --git a/bsd/kern/bsd_init.c b/bsd/kern/bsd_init.c
index d1dbc4b..a2620d1 100644
--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -101,6 +101,12 @@
 #include <sys/dkstat.h>
 #include <sys/codesign.h>
 
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/fcntl.h>
+#include <sys/file_internal.h>
+#include <sys/uio_internal.h>
+#endif
+
 #include <kern/startup.h>
 #include <kern/thread.h>
 #include <kern/task.h>
@@ -1080,6 +1086,188 @@ bsd_init(void)
 	bsd_init_kprintf("done\n");
 }
 
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/*
+ * SWEET A10: read-only probe of the dyld shared cache.
+ *
+ * dyld reports "no dyld cache" while the cache files are hard links whose
+ * inode records live in "HFS+ Private Data".  This probe walks the very same
+ * path user space uses (lookup, getattr, read) and prints what the kernel
+ * sees, so we can tell whether the hard link was resolved and whether the
+ * file contents are reachable.
+ *
+ * Enabled with the boot argument dscprobe=1; does nothing otherwise.
+ */
+
+static uint32_t
+sweet_dsc_sum(const uint8_t *p, size_t n)
+{
+	uint32_t sum = 0;
+	size_t i;
+
+	for (i = 0; i < n; i++) {
+		sum = (sum * 31) + p[i];
+	}
+	return sum;
+}
+
+static uint32_t
+sweet_dsc_le32(const uint8_t *p)
+{
+	return (uint32_t)p[0] | ((uint32_t)p[1] << 8) |
+	    ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+
+static uint64_t
+sweet_dsc_le64(const uint8_t *p)
+{
+	return (uint64_t)sweet_dsc_le32(p) |
+	    ((uint64_t)sweet_dsc_le32(p + 4) << 32);
+}
+
+static int
+sweet_dsc_read(vnode_t vp, off_t offset, void *buf, size_t len,
+    const char *path, const char *what)
+{
+	uio_t auio;
+	int error;
+
+	auio = uio_create(1, offset, UIO_SYSSPACE, UIO_READ);
+	if (auio == NULL) {
+		printf("SWEET DSC: %s %s -> ENOMEM\n", what, path);
+		return ENOMEM;
+	}
+	uio_addiov(auio, (user_addr_t)(uintptr_t)buf, len);
+	error = VNOP_READ(vp, auio, 0, vfs_context_kernel());
+	if (error != 0 || uio_resid(auio) != 0) {
+		printf("SWEET DSC: %s %s -> %d resid=%lld\n", what, path,
+		    error, (long long)uio_resid(auio));
+		if (error == 0) {
+			error = EIO;
+		}
+	}
+	uio_free(auio);
+	return error;
+}
+
+static void
+sweet_dsc_probe_one(const char *path)
+{
+	vnode_t vp = NULLVP;
+	struct vnode_attr va;
+	uint8_t head[512];
+	uint8_t maps[512];
+	char magic[17];
+	off_t size;
+	uint32_t mapping_offset, mapping_count;
+	uint32_t images_offset, images_count;
+	uint64_t images_text_offset, images_text_count;
+	uint64_t base_address, cache_type;
+	uint32_t n, i;
+	int error;
+
+	error = vnode_open(path, O_RDONLY, 0, 0, &vp, vfs_context_kernel());
+	if (error != 0) {
+		printf("SWEET DSC: open %s -> %d\n", path, error);
+		return;
+	}
+
+	VATTR_INIT(&va);
+	VATTR_WANTED(&va, va_fileid);
+	VATTR_WANTED(&va, va_mode);
+	VATTR_WANTED(&va, va_data_size);
+	error = vnode_getattr(vp, &va, vfs_context_kernel());
+	if (error != 0) {
+		printf("SWEET DSC: getattr %s -> %d\n", path, error);
+		(void)vnode_close(vp, FREAD, vfs_context_kernel());
+		return;
+	}
+
+	size = va.va_data_size;
+	printf("SWEET DSC: %s fileid=%llu mode=%o size=%lld\n", path,
+	    (unsigned long long)va.va_fileid, (unsigned)va.va_mode,
+	    (long long)size);
+
+	if (size < (off_t)sizeof(head)) {
+		printf("SWEET DSC: %s too small for a header\n", path);
+		(void)vnode_close(vp, FREAD, vfs_context_kernel());
+		return;
+	}
+
+	error = sweet_dsc_read(vp, 0, head, sizeof(head), path, "head");
+	if (error != 0) {
+		(void)vnode_close(vp, FREAD, vfs_context_kernel());
+		return;
+	}
+
+	memcpy(magic, head, 16);
+	magic[16] = '\0';
+	printf("SWEET DSC: magic '%s' sum=%08x\n", magic,
+	    sweet_dsc_sum(head, 16));
+
+	if (memcmp(head, "dyld_v1", 7) != 0) {
+		(void)vnode_close(vp, FREAD, vfs_context_kernel());
+		return;
+	}
+
+	mapping_offset = sweet_dsc_le32(head + 16);
+	mapping_count = sweet_dsc_le32(head + 20);
+	images_offset = sweet_dsc_le32(head + 24);
+	images_count = sweet_dsc_le32(head + 28);
+	base_address = sweet_dsc_le64(head + 32);
+	images_text_offset = sweet_dsc_le64(head + 136);
+	images_text_count = sweet_dsc_le64(head + 144);
+	cache_type = sweet_dsc_le64(head + 104);
+
+	printf("SWEET DSC: map off=%u cnt=%u imgOld off=%u cnt=%u\n",
+	    mapping_offset, mapping_count, images_offset, images_count);
+	printf("SWEET DSC: imgText off=%llu cnt=%llu base=%llx type=%llu\n",
+	    (unsigned long long)images_text_offset,
+	    (unsigned long long)images_text_count,
+	    (unsigned long long)base_address,
+	    (unsigned long long)cache_type);
+
+	/*
+	 * dyld_cache_mapping_info is 32 bytes; the table sits right after the
+	 * header.  Read the first entries and report the address/size/file
+	 * offset, i.e. exactly what dyld must map.
+	 */
+	n = mapping_count;
+	if (n > 16) {
+		n = 16;
+	}
+	if (n != 0 &&
+	    (uint64_t)mapping_offset + (uint64_t)n * 32 <= (uint64_t)size) {
+		error = sweet_dsc_read(vp, (off_t)mapping_offset, maps,
+		    (size_t)n * 32, path, "maps");
+		if (error == 0) {
+			for (i = 0; i < n && i < 3; i++) {
+				const uint8_t *m = maps + (size_t)i * 32;
+				printf("SWEET DSC: map[%u] addr=%llx size=%llx "
+				    "fileoff=%llx prot=%x\n", i,
+				    (unsigned long long)sweet_dsc_le64(m),
+				    (unsigned long long)sweet_dsc_le64(m + 8),
+				    (unsigned long long)sweet_dsc_le64(m + 16),
+				    sweet_dsc_le32(m + 28));
+			}
+		}
+	}
+
+	if (size >= (off_t)(sizeof(head) * 2)) {
+		uint8_t tail[512];
+
+		error = sweet_dsc_read(vp, size - (off_t)sizeof(tail), tail,
+		    sizeof(tail), path, "tail");
+		if (error == 0) {
+			printf("SWEET DSC: tail sum=%08x\n",
+			    sweet_dsc_sum(tail, sizeof(tail)));
+		}
+	}
+
+	(void)vnode_close(vp, FREAD, vfs_context_kernel());
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
+
 void
 bsdinit_task(void)
 {
@@ -1106,6 +1294,30 @@ bsdinit_task(void)
 
 	bsd_init_kprintf("bsd_do_post - done");
 
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	{
+		int dscprobe = 0;
+
+		if (PE_parse_boot_argn("dscprobe", &dscprobe,
+		    sizeof(dscprobe)) && dscprobe != 0) {
+			printf("SWEET DSC: probe start\n");
+			sweet_dsc_probe_one(
+			    "/System/Library/Caches/com.apple.dyld/"
+			    "dyld_shared_cache_arm64");
+			sweet_dsc_probe_one(
+			    "/System/Library/Caches/com.apple.dyld/"
+			    "dyld_shared_cache_arm64.01");
+			sweet_dsc_probe_one(
+			    "/private/preboot/Cryptexes/OS/System/Library/"
+			    "Caches/com.apple.dyld/dyld_shared_cache_arm64");
+			sweet_dsc_probe_one("/usr/lib/dyld");
+			sweet_dsc_probe_one("/usr/lib/libSystem.B.dylib");
+			sweet_dsc_probe_one("/sbin/launchd");
+			printf("SWEET DSC: probe done\n");
+		}
+	}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
+
 	load_init_program(p);
 	lock_trace = 1;
 }
