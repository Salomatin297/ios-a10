+/* A whole table set for one page at A10_GPU_TEST_VA. */
+static bool
+a10_gpu_pt_build(struct a10_gpu_pt *pt, unsigned levels,
+    uint64_t table_flags, uint64_t pte_flags, uint64_t phys)
+{
+	bzero(pt, sizeof(*pt));
+	pt->levels = levels;
+	pt->table_flags = table_flags;
+	pt->pte_flags = pte_flags;
+	pt->top = a10_gpu_pt_page(&pt->top_phys);
+	if (pt->top == NULL) {
+		return false;
+	}
+	return a10_gpu_map(pt, A10_GPU_TEST_VA, phys);
+}
+
+/* What the processor just put in the tables, for the log. */
+static void
+a10_gpu_pt_dump(struct a10_gpu_pt *pt, uint64_t gpu)
+{
+	uint64_t e0 = 0, e1 = 0, e2 = 0, e3 = 0;
+	uint64_t *t = pt->top;
+
+	if (t == NULL) {
+		printf("A10 GPU: walk: no top table\n");
+		return;
+	}
+	if (pt->levels == 4) {
+		e0 = t[(gpu >> 39) & 511];
+		if (e0 & 1) {
+			t = (uint64_t *)phystokv(e0 & PTE_ADDRESS);
+			e1 = t[(gpu >> 30) & 511];
+		}
+	} else {
+		e0 = t[(gpu >> 30) & 31];
+	}
+	if ((pt->levels == 4 ? e1 : e0) & 1) {
+		t = (uint64_t *)phystokv((pt->levels == 4 ? e1 : e0) &
+		    PTE_ADDRESS);
+		e2 = t[(gpu >> 21) & 511];
+	}
+	if (e2 & 1) {
+		t = (uint64_t *)phystokv(e2 & PTE_ADDRESS);
+		e3 = t[(gpu >> 12) & 511];
+	}
+	printf("A10 GPU: walk %08x%08x: %08x%08x %08x%08x %08x%08x "
+	    "%08x%08x\n",
+	    (uint32_t)(gpu >> 32), (uint32_t)gpu,
+	    (uint32_t)(e0 >> 32), (uint32_t)e0,
+	    (uint32_t)(e1 >> 32), (uint32_t)e1,
+	    (uint32_t)(e2 >> 32), (uint32_t)e2,
+	    (uint32_t)(e3 >> 32), (uint32_t)e3);
 }
 
