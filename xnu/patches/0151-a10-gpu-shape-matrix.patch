+/* The cores the reset may have switched off, on again. */
+static bool
+a10_gpu_ensure_cores(vm_offset_t mali, uint32_t *shader_mask)
+{
+	uint32_t l2, tiler, shader;
+
+	l2 = a10_gpu_read(mali, L2_PRESENT);
+	tiler = a10_gpu_read(mali, TILER_PRESENT);
+	shader = a10_gpu_read(mali, SHADER_PRESENT);
+	if (l2 == 0 || tiler == 0 || shader == 0) {
+		return false;
+	}
+	if ((a10_gpu_read(mali, L2_READY) & l2) != l2) {
+		a10_gpu_write(mali, L2_PWRON, l2);
+		if (!a10_gpu_wait(mali, L2_READY, l2, l2, 50000)) {
+			return false;
+		}
+	}
+	if ((a10_gpu_read(mali, TILER_READY) & tiler) != tiler) {
+		a10_gpu_write(mali, TILER_PWRON, tiler);
+		if (!a10_gpu_wait(mali, TILER_READY, tiler, tiler, 50000)) {
+			return false;
+		}
+	}
+	if ((a10_gpu_read(mali, SHADER_READY) & shader) != shader) {
+		a10_gpu_write(mali, SHADER_PWRON, shader);
+		if (!a10_gpu_wait(mali, SHADER_READY, shader, shader,
+		    50000)) {
+			return false;
+		}
+	}
+	*shader_mask = shader;
+	return true;
+}
