+/*
+ * A job that faults leaves its slot at 0x58; Bifrost does not take another
+ * job there until the GPU is reset.  That is what made probe79's four
+ * shapes all report the same status.  Reset before each attempt.
+ */
+static bool
+a10_gpu_recover(vm_offset_t mali, uint32_t *shader_mask)
+{
+	a10_gpu_write(mali, JS1 + JS_COMMAND_NEXT, 0);
+	a10_gpu_write(mali, JOB_INT_MASK, 0);
+	a10_gpu_write(mali, JOB_INT_CLEAR, 0xffffffffu);
+	a10_gpu_write(mali, MMU_IRQ_CLEAR, 0xffffffffu);
+	if (!a10_gpu_reset(mali)) {
+		return false;
+	}
+	if (!a10_gpu_ensure_cores(mali, shader_mask)) {
+		printf("A10 GPU: cores did not come back after reset, "
+		    "ready shader=%08x tiler=%08x l2=%08x\n",
+		    a10_gpu_read(mali, SHADER_READY),
+		    a10_gpu_read(mali, TILER_READY),
+		    a10_gpu_read(mali, L2_READY));
+		return false;
+	}
+	printf("A10 GPU: after reset js1 status=%08x ready shader=%08x "
+	    "tiler=%08x l2=%08x\n",
+	    a10_gpu_read(mali, JS1 + JS_STATUS),
+	    a10_gpu_read(mali, SHADER_READY),
+	    a10_gpu_read(mali, TILER_READY),
+	    a10_gpu_read(mali, L2_READY));
+	return true;
+}
+
+/* An identity job after a shape: did the slot come back at all? */
+static bool
+a10_gpu_control(vm_offset_t mali, uint32_t *shader_mask, vm_offset_t page,
+    uint32_t value)
+{
+	if (!a10_gpu_recover(mali, shader_mask)) {
+		printf("A10 GPU: control: reset failed\n");
+		return false;
+	}
+	if (!a10_gpu_as0(mali, 0, 2)) {
+		return false;
+	}
+	return a10_gpu_write_value(mali, *shader_mask, page,
+	    (uint64_t)kvtophys(page), value);
+}
