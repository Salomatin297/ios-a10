+static bool
+a10_gpu_try_shape(vm_offset_t mali, uint32_t shader_mask, vm_offset_t page,
+    const char *name, struct a10_gpu_pt *pt, uint64_t transtab,
+    uint32_t transcfg, uint32_t memattr)
+{
+	bool ok;
+
+	printf("A10 GPU: %s top=%08x%08x leaf=%03llx table=%03llx "
+	    "transtab=%08x%08x transcfg=%08x memattr=%08x\n",
+	    name, (uint32_t)(pt->top_phys >> 32), (uint32_t)pt->top_phys,
+	    (unsigned long long)pt->pte_flags,
+	    (unsigned long long)pt->table_flags,
+	    (uint32_t)(transtab >> 32), (uint32_t)transtab,
+	    transcfg, memattr);
+	a10_gpu_pt_dump(pt, A10_GPU_TEST_VA);
+	if (!a10_gpu_as0_mem(mali, transtab, transcfg, memattr)) {
+		printf("A10 GPU: %s: AS0 did not take the tables\n", name);
+		return false;
+	}
+	ok = a10_gpu_write_value(mali, shader_mask, page, A10_GPU_TEST_VA,
+	    A10_GPU_TEST_WORD);
+	printf("A10 GPU: %s job %s\n", name, ok ? "ran" : "did not run");
+	return ok;
+}
