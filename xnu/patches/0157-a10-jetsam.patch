diff --git a/bsd/kern/kern_memorystatus.c b/bsd/kern/kern_memorystatus.c
index 1750d3a..fcf8842 100644
--- a/bsd/kern/kern_memorystatus.c
+++ b/bsd/kern/kern_memorystatus.c
@@ -45,6 +45,9 @@
 #include <mach/host_priv.h>
 #include <mach/mach_host.h>
 #include <pexpert/pexpert.h>
+#if defined(__arm64__)
+#include <pexpert/arm64/board_config.h>     /* A10: ARM64_BOARD_CONFIG_SWEET */
+#endif
 #include <sys/coalition.h>
 #include <sys/kern_event.h>
 #include <sys/proc.h>
@@ -1358,6 +1361,26 @@ memorystatus_init(void)
 		    memorystatus_jetsam_proc_size_panic);
 	}
 
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	/*
+	 * A10: this userland is an iPhone X (3 GB) build and the phone has
+	 * 2 GB, so the per-process high-water limits are too generous and
+	 * kill the wrong things.  Band-based low-memory jetsam stays on:
+	 * without it launchd's SET_JETSAM_HIGH_WATER_MARK returns EINVAL,
+	 * nothing reclaims memory, and with no writable swap volume the VM
+	 * can only drop file pages (the log shows "Failed to open swap file
+	 * 2" and repeated full eMMC re-reads).  sweet_memlimits=1 restores
+	 * the per-process limits.
+	 */
+	{
+		int limits = 0;
+		PE_parse_boot_argn("sweet_memlimits", &limits, sizeof(limits));
+		memorystatus_highwater_enabled = limits ? 1 : 0;
+		printf("A10 JETSAM: on, per-process memory limits %s\n",
+		    limits ? "on" : "off (sweet_memlimits=0)");
+	}
+#endif
+
 	/* Apply overrides */
 	if (!PE_parse_boot_argn("kern.jetsam_delta", &delta_percentage, sizeof(delta_percentage))) {
 		PE_get_default("kern.jetsam_delta", &delta_percentage, sizeof(delta_percentage));
