 bool
 waitq_lock_reserve(waitq_t wq, uint32_t *ticket)
 {
-	return hw_lck_ticket_reserve(&wq.wq_q->waitq_interlock, ticket, &waitq_lck_grp);
+	hw_lck_ticket_t *lck = &wq.wq_q->waitq_interlock;
+
+	/*
+	 * Mirror the check hw_lck_ticket_verify() is about to make, but
+	 * report the waitq and its context first.  A live lock always has
+	 * lck_type == LCK_TYPE_TICKET and lck_valid set, so this branch is
+	 * never taken on a healthy system.
+	 */
+	if (__improbable(lck->lck_type != LCK_TYPE_TICKET || !lck->lck_valid)) {
+		waitq_lock_reserve_diag(wq, lck);
+	}
+
+	return hw_lck_ticket_reserve(lck, ticket, &waitq_lck_grp);
 }
 
