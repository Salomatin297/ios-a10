+/*
+ * A10 SMP bring-up diagnostic.
+ *
+ * hw_lck_ticket_reserve() panics with the embedded lock address only, and
+ * an address inside a bogus waitq says nothing: the waitq itself may be a
+ * stale link target or a wild thread->waitq.  Before that panic fires,
+ * dump the object, the caller context stashed by the call site, and the
+ * state of the global waitq table, because the panic string is the only
+ * output that survives to the persistent eMMC log.
+ */
+static void
+waitq_lock_reserve_diag(waitq_t wq, hw_lck_ticket_t *lck)
+{
+	char name[64];
+	thread_t thr = current_thread();
+	/*
+	 * Snapshot the call-site context before the table scan: the
+	 * globals are not synchronized and another CPU could overwrite
+	 * them while this one is printing.
+	 */
+	uint32_t site = waitq_diag_site;
+	struct waitq *dwq = waitq_diag_wq;
+	struct waitq *orig = waitq_diag_orig;
+	struct waitq_set *set = waitq_diag_wqset;
+	void *link = waitq_diag_link;
+	thread_t dthr = waitq_diag_thread;
+	uint32_t otype = orig ? (*(uint32_t *)orig & 7) : 0;
+	unsigned long oalign = orig ? ((uintptr_t)orig & 15) : 0;
+	uint32_t bad = 0;
+	long first = -1;
+	uint32_t ftype = 0;
+	uint32_t fflags = 0;
+
+	thread_get_thread_name(thr, name);
+	name[sizeof(name) - 1] = '\0';
+
+	/*
+	 * Scan the hash table for other corrupt elements, but fold the
+	 * result into the panic string: printf() before panic() would
+	 * compete for the console and its lines are not guaranteed to
+	 * reach the persistent log.
+	 */
+	if (global_waitqs != NULL && g_num_waitqs > 0 &&
+	    g_num_waitqs <= (1u << 20)) {
+		for (uint32_t i = 0; i < g_num_waitqs; i++) {
+			hw_lck_ticket_t *l = &global_waitqs[i].waitq_interlock;
+
+			if (l->lck_type != LCK_TYPE_TICKET || !l->lck_valid) {
+				if (first < 0) {
+					first = (long)i;
+					ftype = l->lck_type;
+					fflags = *(uint32_t *)&global_waitqs[i];
+				}
+				bad++;
+			}
+		}
+	}
+
+	panic("SWEET WQ: bad lock site=%u wq=%p dwq=%p lck=%p type=%u "
+	    "valid=%u flags=%08x align=%lu off=%ld base=%p num=%u "
+	    "orig=%p otype=%u oalign=%lu set=%p link=%p thr=%p '%s' "
+	    "tid=%llu twq=%p tev=%p dthr=%p dtid=%llu scan=%u/%u "
+	    "first=%ld ftype=%u fflags=%08x ra=%p/%p",
+	    site, wq.wq_q, dwq, lck, lck->lck_type,
+	    lck->lck_valid, *(uint32_t *)wq.wq_q,
+	    (unsigned long)((uintptr_t)wq.wq_q & 15),
+	    (long)((uintptr_t)wq.wq_q - (uintptr_t)global_waitqs),
+	    global_waitqs, g_num_waitqs, orig, otype, oalign, set,
+	    link, thr, name, (unsigned long long)thread_tid(thr),
+	    thr->waitq.wq_q, (void *)(uintptr_t)thr->wait_event,
+	    dthr, (unsigned long long)thread_tid(dthr),
+	    bad, g_num_waitqs, first, ftype, fflags,
+	    __builtin_return_address(0), __builtin_return_address(1));
+}
