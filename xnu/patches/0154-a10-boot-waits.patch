diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -177,6 +177,21 @@
 
 OSDefineMetaClassAndStructors(AppleCLCD, IOMobileFramebuffer);
 
+/*
+ * The GPU service class QuartzCore looks for.  Without it,
+ * CAMetalContextCreate polls IOServiceMatching("IOAcceleratorES") 300
+ * times, 100 ms apart -- thirty seconds in every process that draws, and
+ * again at every backboardd start.  This object carries no MetalPluginName
+ * and no MetalPluginClassName, so Metal finds it, passes it over, and leaves
+ * the renderers as they were; the poll itself stops on the first match.
+ * sweetaccel=0 publishes nothing (the old 30 s wait).
+ */
+class IOAcceleratorES : public IOService {
+	OSDeclareDefaultStructors(IOAcceleratorES);
+};
+
+OSDefineMetaClassAndStructors(IOAcceleratorES, IOService);
+
 class IOMobileFramebufferUserClient : public IOUserClient {
 	OSDeclareDefaultStructors(IOMobileFramebufferUserClient);
 
@@ -286,6 +301,23 @@
 	registerService();
 	IOLog("SWEET FB: AppleCLCD %ux%u stride %u at 0x%llx, default surface %u, presented as %ux%u\n",
 	    fWidth, fHeight, fRowBytes, fPhys, fSurface->id, fLogicalW, fLogicalH);
+	{
+		uint32_t accel_on = 1;
+		IOAcceleratorES *accel;
+
+		(void)PE_parse_boot_argn("sweetaccel", &accel_on,
+		    sizeof(accel_on));
+		accel = accel_on ? OSTypeAlloc(IOAcceleratorES) : NULL;
+		if (accel != NULL && accel->init()) {
+			accel->setName("sgx");
+			if (accel->attach(this)) {
+				accel->registerService();
+				IOLog("SWEET FB: empty IOAcceleratorES published "
+				    "(no 30 s CAMetalContextCreate wait)\n");
+			}
+		}
+		OSSafeReleaseNULL(accel);
+	}
 	return true;
 }
 
