diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -101,6 +101,22 @@
 static bool sweet_fb_keepon;
 static uint32_t sweet_fb_fit_copies;
 static uint32_t sweet_fb_fit_rejects;
+/*
+ * The user reports one or two frames a second.  Two very different things
+ * could cause it: the iOS-side compositor swapping rarely (nothing to draw
+ * faster), or this kernel's own per-frame copy into the panel eating the
+ * cores (11 MB of nearest-neighbour scaling per full-screen layer).  Count
+ * both: every ten seconds of vsync print how many swaps userland made, how
+ * many frames were presented and how long each present took in the kernel.
+ */
+static uint64_t sweet_fb_swap_count;
+static uint64_t sweet_fb_present_count;
+static uint64_t sweet_fb_present_ns;
+static uint64_t sweet_fb_present_max_ns;
+static uint64_t sweet_fb_stat_last_ns;
+static uint64_t sweet_fb_stat_last_swaps;
+static uint64_t sweet_fb_stat_last_presents;
+static uint32_t sweet_fb_stat_last_fit;
 /* Size the framebuffer reports to userland; HID uses the same space. */
 static uint32_t sweet_fb_logical_w;
 static uint32_t sweet_fb_logical_h;
@@ -336,8 +352,39 @@
 	}
 	IOLockUnlock(fb->fLock);
 	if (rec != NULL) {
+		uint64_t t0 = mach_absolute_time();
+		uint64_t t1, ns = 0;
 		fb->present(rec);
+		t1 = mach_absolute_time();
+		absolutetime_to_nanoseconds(t1 - t0, &ns);
+		sweet_fb_present_count++;
+		sweet_fb_present_ns += ns;
+		if (ns > sweet_fb_present_max_ns) {
+			sweet_fb_present_max_ns = ns;
+		}
 		IOFreeData(rec, SWEET_FB_SWAP_REC_SIZE);
+	}
+	if ((count % 600) == 0) {
+		uint64_t now_ns = 0, elapsed, swaps, presents, avg = 0;
+		absolutetime_to_nanoseconds(mach_absolute_time(), &now_ns);
+		elapsed = now_ns - sweet_fb_stat_last_ns;
+		swaps = sweet_fb_swap_count - sweet_fb_stat_last_swaps;
+		presents = sweet_fb_present_count - sweet_fb_stat_last_presents;
+		if (presents != 0) {
+			avg = sweet_fb_present_ns / presents;
+		}
+		IOLog("SWEET FB: %llu ms: %llu swaps (%llu/s), %llu presents, "
+		    "copy avg %llu us max %llu us, %u fit copies\n",
+		    elapsed / 1000000, swaps,
+		    elapsed != 0 ? swaps * 1000000 / elapsed : 0, presents,
+		    avg / 1000, sweet_fb_present_max_ns / 1000,
+		    sweet_fb_fit_copies - sweet_fb_stat_last_fit);
+		sweet_fb_stat_last_ns = now_ns;
+		sweet_fb_stat_last_swaps = sweet_fb_swap_count;
+		sweet_fb_stat_last_presents = sweet_fb_present_count;
+		sweet_fb_stat_last_fit = sweet_fb_fit_copies;
+		sweet_fb_present_ns = 0;
+		sweet_fb_present_max_ns = 0;
 	}
 	sender->setTimeoutUS(SWEET_FB_VSYNC_US);
 }
@@ -370,7 +417,6 @@
 }
 
 static uint32_t sweet_fb_swaps_logged;
-static uint64_t sweet_fb_swap_count;
 static uint32_t sweet_fb_frames_logged;
 static uint32_t sweet_fb_pix_logged;
 static uint32_t sweet_fb_fit_logged;
