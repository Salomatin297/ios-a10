+/*
+ * Synchronous checkpoint used by the SMP bring-up path.  The writer thread
+ * only wakes every 10 ms, and a panic in startAll() stops it before it can
+ * mirror the ring; flushing at each CPU_ON boundary keeps the last console
+ * text (and the panic, via sweet_emmc_log_sync) on the eMMC.
+ */
+void
+sweet_emmc_log_flush_now(const char *tag)
+{
+	int error;
+
+	if (!sweet_emmc_log_enabled || !se.writable) {
+		return;
+	}
+	lck_mtx_lock(&sweet_emmc_lock);
+	error = sweet_emmc_log_flush();
+	lck_mtx_unlock(&sweet_emmc_lock);
+	if (error) {
+		printf("SWEET LOG: %s flush failed (%d)\n", tag, error);
+	}
+}
+
+static bool sweet_emmc_brought_up;
+
+/*
+ * Map the controller, initialize the card and locate the selected GPT
+ * partition.  Split out of sweet_emmc_init() so the SMP bring-up thread can
+ * do it before releasing any secondary CPU: a panic in that window happens
+ * before the block device (and the log writer) exists otherwise.
+ */
 static int
-sweet_emmc_init(void)
+sweet_emmc_bringup(void)
 {
 	char partition[64] = "userdata";
 	uint32_t rw = 0;
@@ -1487,6 +1527,51 @@ sweet_emmc_init(void)
 		printf("SWEET eMMC: initialization failed: %d\n", error);
 		return error;
 	}
+	se.writable = (rw == 1);
+	return 0;
+}
+
+/*
+ * Early entry point for iokit/Kernel/arm/SweetCPU.cpp.  Starts the persistent
+ * console log before the first PSCI CPU_ON so an SMP panic is captured even
+ * though the framebuffer console and the regular root-device probe have not
+ * run yet.  Safe to call more than once.
+ */
+int
+sweet_emmc_early_init(void)
+{
+	int error;
+
+	if (sweet_emmc_log_enabled) {
+		return 0;
+	}
+	if (!sweet_emmc_brought_up) {
+		error = sweet_emmc_bringup();
+		if (error != 0) {
+			return error;
+		}
+		sweet_emmc_brought_up = true;
+		printf("SWEET eMMC: early bring-up done, LBA 0x%llx, %s\n",
+		    se.first_sector, se.writable ? "read-write" : "read-only");
+	}
+	sweet_emmc_log_start();
+	return sweet_emmc_log_enabled ? 0 : ENXIO;
+}
+
+static int
+sweet_emmc_init(void)
+{
+	int error;
+
+	if (!sweet_emmc_brought_up) {
+		error = sweet_emmc_bringup();
+		if (error != 0) {
+			return error;
+		}
+		sweet_emmc_brought_up = true;
+	} else {
+		printf("SWEET eMMC: reusing early bring-up\n");
+	}
 	se.bmajor = bdevsw_add(-1, &sweet_emmc_bdevsw);
 	if (se.bmajor < 0) {
 		return ENXIO;
@@ -1500,8 +1585,6 @@ sweet_emmc_init(void)
 	    "emmcroot0");
 	devfs_make_node(makedev(se.cmajor, 0), DEVFS_CHAR, UID_ROOT,
 	    GID_OPERATOR, 0640, "remmcroot0");
-	/* Enable writes only after the selected partition has been bounded. */
-	se.writable = (rw == 1);
 	{
 		uint32_t wtest = 0;
 		PE_parse_boot_argn("emmcwtest", &wtest, sizeof(wtest));
@@ -1510,8 +1593,8 @@ sweet_emmc_init(void)
 		}
 	}
 	se.ready = true;
-	printf("SWEET eMMC: \"%s\": LBA 0x%llx, %llu MiB, %s, %u-bit PIO, fifo=%u\n",
-	    partition, se.first_sector,
+	printf("SWEET eMMC: root: LBA 0x%llx, %llu MiB, %s, %u-bit PIO, fifo=%u\n",
+	    se.first_sector,
 	    se.partition_sectors * EMMC_BLOCK_SIZE >> 20,
 	    se.writable ? "read-write" : "read-only", se.bus_width,
 	    1u << se.fifo_shift);
