diff --git a/osfmk/arm64/cpu.c b/osfmk/arm64/cpu.c
index b082a10..2625e5e 100644
--- a/osfmk/arm64/cpu.c
+++ b/osfmk/arm64/cpu.c
@@ -975,6 +975,22 @@ sweet_cpu_signal_is_enabled(unsigned int cpu)
 	cpu_data_t *cdp = CpuDataEntries[cpu].cpu_data_vaddr;
 	return cdp != NULL && !(os_atomic_load(&cdp->cpu_signal, acquire) & SIGPdisabled);
 }
+
+/*
+ * Bring-up fallback: the starting CPU may clear the latch itself once the
+ * secondary has published initialized.  Used only when the bring-up SGI is
+ * not delivered; cross-CPU IPIs then prove whether SGI delivery works.
+ */
+void
+sweet_cpu_signal_force_enable(unsigned int cpu)
+{
+	if (cpu < MAX_CPUS) {
+		cpu_data_t *cdp = CpuDataEntries[cpu].cpu_data_vaddr;
+		if (cdp != NULL) {
+			os_atomic_andnot(&cdp->cpu_signal, SIGPdisabled, relaxed);
+		}
+	}
+}
 #endif
 
 
diff --git a/pexpert/arm/pe_fiq.c b/pexpert/arm/pe_fiq.c
index 10b0310..323ce2d 100644
--- a/pexpert/arm/pe_fiq.c
+++ b/pexpert/arm/pe_fiq.c
@@ -300,6 +300,46 @@ pe_sweet_gic_broadcast_sgi(uint32_t intid)
 	__builtin_arm_isb(ISB_SY);
 }
 
+/*
+ * TargetListFilter = 0b00 with an explicit CPUTargetList.  The Exynos GIC
+ * CPU-interface number for Aff0/Aff1 is not documented, so bring-up diagnostics
+ * walk one interface at a time instead of trusting a mapping.
+ */
+void
+pe_sweet_gic_target_sgi(uint32_t intid, uint32_t targets)
+{
+	__builtin_arm_dsb(DSB_ISHST);
+	sweet_gicd_write32(GICD_SGIR,
+	    GICD_SGIR_FILTER_TARGETS | ((targets & 0xFF) << 16) |
+	    (intid & 0xF));
+	__builtin_arm_isb(ISB_SY);
+}
+
+/*
+ * Diagnostic view of the distributor/CPU interface from the current core.
+ * Called with IRQs masked so the pending SGI is still visible in ISPENDR.
+ */
+void
+pe_sweet_gic_snapshot(uint32_t *typer, uint32_t *isen, uint32_t *pend,
+    uint32_t *ctlr, uint32_t *hppir)
+{
+	if (typer != NULL) {
+		*typer = sweet_gicd_read32(GICD_TYPER);
+	}
+	if (isen != NULL) {
+		*isen = sweet_gicd_read32(GICD_ISENABLER);
+	}
+	if (pend != NULL) {
+		*pend = sweet_gicd_read32(GICD_ISPENDR);
+	}
+	if (ctlr != NULL) {
+		*ctlr = sweet_gicc_read32(GICC_CTLR);
+	}
+	if (hppir != NULL) {
+		*hppir = sweet_gicc_read32(GICC_HPPIR);
+	}
+}
+
 void
 pe_init_fiq()
 {
