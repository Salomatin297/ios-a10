diff --git a/bsd/dev/sweet_emmc.c b/bsd/dev/sweet_emmc.c
index 1aee99d..584a763 100644
--- a/bsd/dev/sweet_emmc.c
+++ b/bsd/dev/sweet_emmc.c
@@ -1288,14 +1288,35 @@ sweet_emmc_log_flush(void)
 		uint32_t n = (uint32_t)MIN(MIN(need,
 		    (uint64_t)(SWEET_EMMC_LOG_BLOCKS - blk)),
 		    (uint64_t)(EMMC_MAX_XFER / EMMC_BLOCK_SIZE));
-		uint32_t want = (uint32_t)MIN(total - pos,
-		    (uint64_t)n * EMMC_BLOCK_SIZE - skip);
-		uint64_t copy = pos;
-
+		/*
+		 * Fill every block that is written with the ring bytes that
+		 * belong to it.  The old code copied only the new tail into a
+		 * zeroed bounce buffer and wrote that, so every flush erased
+		 * the part of the block an earlier flush had already written:
+		 * a partial block lost everything in front of the new bytes
+		 * and the blocks behind it were zeroed.  That is how console
+		 * lines went missing from the log (the touch driver was
+		 * running, but its output was overwritten by the next flush),
+		 * and it also hid the panic text of a failed SMP bring-up.
+		 */
 		bzero(emmc_bounce, n * EMMC_BLOCK_SIZE);
-		(void)sweet_log_copy(&copy, (char *)emmc_bounce + skip, want);
+		for (uint32_t i = 0; i < n; i++) {
+			uint64_t block_start = (uint64_t)(blk + i) * EMMC_BLOCK_SIZE;
+			uint64_t avail = MIN((uint64_t)(blk + i + 1) * EMMC_BLOCK_SIZE,
+			    total) - block_start;
+			uint64_t copy = block_start;
+
+			if (avail > 0) {
+				(void)sweet_log_copy(&copy,
+				    (char *)emmc_bounce + (uint64_t)i * EMMC_BLOCK_SIZE,
+				    (uint32_t)avail);
+			}
+		}
 		error = emmc_transfer(base + 1 + blk, n, emmc_bounce, true);
-		pos += want;
+		pos = (uint64_t)(blk + n) * EMMC_BLOCK_SIZE;
+		if (pos > total) {
+			pos = total;
+		}
 	}
 	if (!error) {
 		struct sweet_emmc_log_header h = {
diff --git a/osfmk/arm64/machine_routines.c b/osfmk/arm64/machine_routines.c
index a8e8f16..18e5405 100644
--- a/osfmk/arm64/machine_routines.c
+++ b/osfmk/arm64/machine_routines.c
@@ -1034,12 +1034,27 @@ ml_parse_cpu_topology(void)
 		ml_read_reg_range(child, "coresight-reg", &cpu->coresight_pa, &cpu->coresight_len);
 		cpu->cluster_type = CLUSTER_TYPE_SMP;
 
+#if defined(SWEET)
+		/*
+		 * The A10 has three physical clusters (two Cortex-A73 in cluster 0,
+		 * four Cortex-A53 in cluster 1 and two more in cluster 2) but this
+		 * build keeps a single logical SMP cluster: MAX_CPU_CLUSTERS is 1,
+		 * so __ARM_AMP__ is compiled out and the AMP scheduler is not
+		 * available.  An ADT that carries the "cluster-type" property of
+		 * the upstream A10 (or of the A30) must not be honoured here:
+		 * 'P' would assert in phys_cluster_id <= MAX_CPU_CLUSTER_PHY_ID
+		 * (probe48) and 'E'/'P' would build the AMP psets that this port
+		 * cannot schedule (probe43-45).  Ignore the property and keep one
+		 * SMP cluster, whatever the ADT says.
+		 */
+#else
 		int cluster_type = (int)ml_readprop(child, "cluster-type", 0);
 		if (cluster_type == 'E') {
 			cpu->cluster_type = CLUSTER_TYPE_E;
 		} else if (cluster_type == 'P') {
 			cpu->cluster_type = CLUSTER_TYPE_P;
 		}
+#endif /* SWEET */
 
 		topology_info.cluster_type_num_cpus[cpu->cluster_type]++;
 
@@ -1050,6 +1065,9 @@ ml_parse_cpu_topology(void)
 		 */
 #if HAS_CLUSTER
 		uint32_t phys_cluster_id = MPIDR_CLUSTER_ID(cpu->phys_id);
+#elif defined(SWEET)
+		/* One logical cluster: the three physical clusters are collapsed. */
+		uint32_t phys_cluster_id = 0;
 #else
 		uint32_t phys_cluster_id = (cpu->cluster_type == CLUSTER_TYPE_P);
 #endif
