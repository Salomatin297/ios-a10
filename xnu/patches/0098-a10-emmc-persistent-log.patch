 	SHARED_REGION_TRACE_INFO(
 		("shared_region: -> create(root=%p,cpu=<%d,%d>,64bit=%d,pgshift=%d,reslide=%d,driverkit=%d)\n",
 		(void *)VM_KERNEL_ADDRPERM(root_dir),
