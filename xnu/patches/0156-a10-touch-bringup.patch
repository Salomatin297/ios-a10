+/*
+ * After power-on the IC runs its own boot and then reports app mode.  The
+ * boot-complete event is a status event: byte 0 = 0x09 (status, INFO),
+ * byte 1 = 0x00 (ack), byte 2 = 0x20 (app mode).  Reading 0x55 is the
+ * authoritative check; the event only tells us the queue is alive.
+ */
+static bool
+a10_touch_wait_app_mode(unsigned ms)
+{
+	uint8_t e[A10_TOUCH_EVENT_SIZE];
+	uint8_t boot = 0;
+	unsigned waited = 0;
+	bool saw_boot = false;
+
+	while (waited < ms) {
+		if (sec_ts_read(SEC_TS_READ_ONE_EVENT, e, sizeof(e)) &&
+		    e[0] != 0) {
+			int eid = e[0] & 0x3;
+			int stype = (e[0] >> 2) & 0xf;
+
+			if (a10_touch_debug) {
+				printf("A10 TOUCH: boot ev %02x %02x %02x\n",
+				    e[0], e[1], e[2]);
+			}
+			if (eid == SEC_TS_EVENT_STATUS &&
+			    stype == SEC_TS_STYPE_INFO &&
+			    e[1] == SEC_TS_ACK_BOOT_COMPLETE) {
+				saw_boot = true;
+			}
+		}
+		if (sec_ts_read(SEC_TS_READ_BOOT_STATUS, &boot, 1) &&
+		    boot == SEC_TS_STATUS_APP_MODE) {
+			printf("A10 TOUCH: app mode after %u ms%s\n", waited,
+			    saw_boot ? " (boot event seen)" : "");
+			return true;
+		}
+		a10_touch_wait_ms(20);
+		waited += 20;
+	}
+	printf("A10 TOUCH: no app mode after %u ms (boot status %02x)\n",
+	    ms, boot);
+	return false;
+}
