+/*
+ * A transaction is at most nine bytes (register + eight data), about one
+ * millisecond at 100 kHz.  Keep the thread on the CPU for that long: the
+ * IC resets its I2C state machine when SCL stays low across a context
+ * switch, and the next transfer then lands mid-byte.
+ */
+static bool
+a10_i2c_write(uint8_t addr, const uint8_t *buf, int len)
+{
+	bool ok;
+
+	disable_preemption();
+	ok = a10_i2c_write_locked(addr, buf, len);
+	enable_preemption();
+	return ok;
+}
+
+static bool
+a10_i2c_read(uint8_t addr, uint8_t reg, uint8_t *buf, int len)
