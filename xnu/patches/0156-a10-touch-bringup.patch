+static void
+a10_touch_power_cycle(void)
+{
+	printf("A10 TOUCH: power-cycling tsp_ldo_en (GPG2-1)\n");
+	a10_touch_ldo(0);
+	a10_touch_wait_ms(40);
+	/* The IC is off; make sure no slave is still holding SDA. */
+	a10_touch_recover();
+	a10_touch_ldo(1);
+	a10_touch_wait_ms(120);
+	a10_touch_dump_gpio("power-on");
