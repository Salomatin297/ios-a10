diff --git a/pexpert/pexpert/arm64/board_config.h b/pexpert/pexpert/arm64/board_config.h
index 88e524a..f13157d 100644
--- a/pexpert/pexpert/arm64/board_config.h
+++ b/pexpert/pexpert/arm64/board_config.h
@@ -102,7 +102,14 @@
 
 #define MAX_L2_CLINE                   6
 #define MAX_CPUS                       8
-#define MAX_CPU_CLUSTERS               1
+/*
+ * Two logical clusters: the six Cortex-A53s are the E cluster and the two
+ * Cortex-A73s the P cluster (the A10 has three physical clusters, which the
+ * ADT collapses into E/P because this build has HAS_CLUSTER=0).  With one
+ * cluster __ARM_AMP__ is compiled out and a "cluster-type" of 'P'/'E' would
+ * assert in ml_parse_cpu_topology().
+ */
+#define MAX_CPU_CLUSTERS               2
 
 #define CORE_NCTRS                     8 /* Placeholder; KPC is not enabled for this target */
 
diff --git a/pexpert/pexpert/arm64/SWEET.h b/pexpert/pexpert/arm64/SWEET.h
index fd2b8f7..5002196 100644
--- a/pexpert/pexpert/arm64/SWEET.h
+++ b/pexpert/pexpert/arm64/SWEET.h
@@ -18,10 +18,12 @@
 #define SWEET                     1
 
 /*
- * All eight cores (six A55 + two A76) as one homogeneous SMP cluster:
- * cpus=N is clamped here. Same ISA level (ARMv8.2), 64-byte lines, PSCI
- * CPU_ON; the scheduler does not know the A76s are faster (no AMP/P-E
- * clusters yet).
+ * All eight cores are selectable with cpus=N (clamped here).  On the A10
+ * that is six Cortex-A53s (E) plus two Cortex-A73s (P); the ADT marks them
+ * with cluster-type 'E'/'P' and board_config gives SWEET two logical
+ * clusters, so XNU builds the AMP psets.  Leaving cluster-type at 0 keeps
+ * the older homogeneous SMP behaviour, which is useful for A/B testing
+ * without a kernel rebuild.
  */
 #define SWEET_SMP_MAX_CPUS         8
 
