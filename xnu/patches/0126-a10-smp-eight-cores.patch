diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index 71b7dc7..87b1ab2 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -207,6 +207,19 @@ Lfound_cpu_data_entry:
 	SWEET_SMP_MARK 2, 3
 	adrp	x20, EXT(const_boot_args)@page
 	add		x20, x20, EXT(const_boot_args)@pageoff
+#if defined(SWEET)
+	/*
+	 * The A10 has no CPU idle/suspend: every core that reaches this
+	 * point was released by SweetCPU::startCPU() as a cold start.
+	 * The generic path validates cpu_reset_handler against
+	 * start_cpu/resume_idle_cpu before branching.  On this port the
+	 * field is not reliable: probe40 reached slot 2 (cpu_data match)
+	 * but never wrote slot 3, although every CPU_ON SMC returned 0,
+	 * and a failed validation spins at Lskip_cpu_reset_handler.  Enter
+	 * the cold-start trampoline directly instead.
+	 */
+	b		EXT(start_cpu)
+#endif /* SWEET */
 	ldr		x0, [x21, CPU_RESET_HANDLER]		// Call CPU reset handler
 	cbz		x0, Lskip_cpu_reset_handler
 
