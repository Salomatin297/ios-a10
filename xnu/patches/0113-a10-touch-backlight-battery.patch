+/*
+ * Absolute coordinates are reported as 0..65535 over the physical panel;
+ * SweetHID maps them onto whatever logical display it presents.
+ */
+static void
+a10_touch_report(int finger, int down, int x, int y)
+{
+	uint32_t nx, ny;
+
+	if (down) {
+		a10_touch_last_x[finger] = x;
+		a10_touch_last_y[finger] = y;
+	} else {
+		/* Release events often carry zero; keep the contact point. */
+		x = a10_touch_last_x[finger];
+		y = a10_touch_last_y[finger];
+	}
+	if (x < 0) {
+		x = 0;
+	}
+	if (y < 0) {
+		y = 0;
+	}
+	if (x > A10_TOUCH_MAX_X - 1) {
+		x = A10_TOUCH_MAX_X - 1;
+	}
+	if (y > A10_TOUCH_MAX_Y - 1) {
+		y = A10_TOUCH_MAX_Y - 1;
+	}
+	nx = (uint32_t)(((uint64_t)x * 65535u) / (A10_TOUCH_MAX_X - 1));
+	ny = (uint32_t)(((uint64_t)y * 65535u) / (A10_TOUCH_MAX_Y - 1));
+	sweet_hid_touch_abs(finger, down, nx, ny);
+}
