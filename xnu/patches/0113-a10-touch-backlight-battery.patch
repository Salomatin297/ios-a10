+	if (a10_peri == 0) {
+		a10_peri = ml_io_map(A10_PERI_PA, A10_PERI_SIZE);
+	}
+	if (a10_pctrl == 0) {
+		a10_pctrl = ml_io_map(A10_PCTRL_PA, A10_PCTRL_SIZE);
+	}
+	return a10_i2c_bus_init(4, a10_i2c_bl, A10_BL_ADDR, "backlight");
