+/*
+ * The I2C input clock comes from the PERI bus mux and is not documented
+ * here.  Try the dividers that fit the common Exynos rates (66.5, 100,
+ * 133 and 200 MHz) and, if none ACKs, sweep every divider.
+ */
+static bool
+a10_i2c_probe_config(vm_offset_t base, uint8_t addr, const char *name)
+{
+	static const uint32_t candidates[] = {
+		IICCON_ACKEN | IICCON_IRQEN | IICCON_TXDIV512 | 0x0,
+		IICCON_ACKEN | IICCON_IRQEN | 0xa,
+		IICCON_ACKEN | IICCON_IRQEN | 0xf,
+		IICCON_ACKEN | IICCON_IRQEN | IICCON_TXDIV512 | 0xf,
+	};
+	uint32_t con;
+
+	for (unsigned i = 0; i < sizeof(candidates) / sizeof(candidates[0]); i++) {
+		a10_i2c_wr(base, S3C_IICSTAT, 0);
+		a10_i2c_wr(base, S3C_IICCON, candidates[i]);
+		delay(50);
+		if (a10_i2c_ping(base, addr) == 0) {
+			printf("A10 BATTERY: %s divider %u/%s\n", name,
+			    (candidates[i] & IICCON_SCALEMASK) + 1u,
+			    (candidates[i] & IICCON_TXDIV512) ? "512" : "16");
+			return true;
+		}
+	}
+	for (unsigned div1 = 0; div1 < 2; div1++) {
+		for (unsigned scale = 0; scale < 16; scale++) {
+			con = IICCON_ACKEN | IICCON_IRQEN | scale;
+			if (div1) {
+				con |= IICCON_TXDIV512;
+			}
+			a10_i2c_wr(base, S3C_IICSTAT, 0);
+			a10_i2c_wr(base, S3C_IICCON, con);
+			delay(50);
+			if (a10_i2c_ping(base, addr) == 0) {
+				printf("A10 BATTERY: %s divider %u/%s "
+				    "(sweep)\n", name, scale + 1u,
+				    div1 ? "512" : "16");
+				return true;
+			}
+		}
+	}
+	return false;
+}
