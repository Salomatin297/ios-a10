+static void
+a10_touch_ldo(int on)
+{
+	uint32_t dat = A10_GPG2_OFF + A10_PIN_DAT;
+	uint32_t v = a10_touch_rd(dat);
+	unsigned shift = A10_TOUCH_LDO_PIN;
+
+	/* Set the level while the pin is still an input, then drive it. */
+	if (on) {
+		v |= 1u << shift;
+	} else {
+		v &= ~(1u << shift);
+	}
+	a10_touch_wr(dat, v);
+	a10_pin_pud(A10_GPG2_OFF, shift, 0);
+	a10_pin_func(A10_GPG2_OFF, shift, 1);
+}
