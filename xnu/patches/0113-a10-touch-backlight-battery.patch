+static bool
+a10_touch_id_valid(const uint8_t *id)
+{
+	bool zero = true, ones = true;
+
+	for (int i = 0; i < 5; i++) {
+		if (id[i] != 0x00) {
+			zero = false;
+		}
+		if (id[i] != 0xff) {
+			ones = false;
+		}
+	}
+	return !zero && !ones;
