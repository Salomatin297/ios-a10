+static bool
+a10_i2c_bus_init(unsigned idx, vm_offset_t base, uint8_t addr,
+    const char *name)
+{
+	bool ok;
+
+	if (base == 0) {
+		printf("A10 BATTERY: i2c%u %s MMIO mapping failed\n", idx, name);
+		return false;
+	}
+	a10_i2c_ungate(idx, name);
+	a10_i2c_wr(base, S3C_IICSTAT, 0);
+	a10_i2c_wr(base, S3C_IICCON, 0);
+	delay(100);
+
+	ok = a10_i2c_probe_config(base, addr, name);
+	printf("A10 BATTERY: i2c%u %s at 0x%02x %s, con=%08x stat=%08x\n",
+	    idx, name, addr, ok ? "acked" : "did not respond",
+	    a10_i2c_rd(base, S3C_IICCON), a10_i2c_rd(base, S3C_IICSTAT));
+	return ok;
+}
