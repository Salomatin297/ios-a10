diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index aab55bb..71b7dc7 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -88,6 +88,48 @@
 #endif /* defined(KERNEL_INTEGRITY_KTRR) */
 .endmacro
 
+#if defined(SWEET)
+/*
+ * A10 SMP secondary-boot progress markers (patch 0125).
+ *
+ * sweet_smp_mark holds 64 rows of 8 words, indexed by
+ * (MPIDR.Aff0 | (MPIDR.Aff1 << 4)) & 0x3f.  A secondary writes its row
+ * with the MMU and caches off, so the stores are Device-nGnRnE and land
+ * in DRAM; the bring-up CPU clean+invalidates the whole array before
+ * CPU_ON and again before reading it.  Slot 7 is written by
+ * SweetCPU::initCPU() once the generic boot path reaches C.
+ *
+ * Clobbers x9-x12 only; never x0-x2, x19-x26 or lr.
+ */
+.macro SWEET_SMP_MARK slot, value
+	mrs		x9, MPIDR_EL1
+	and		x10, x9, #0xf
+	ubfx	x11, x9, #8, #4
+	orr		x10, x10, x11, lsl #4
+	adrp	x12, EXT(sweet_smp_mark)@page
+	add		x12, x12, EXT(sweet_smp_mark)@pageoff
+	add		x12, x12, x10, lsl #6
+	mov		x11, #\value
+	str		x11, [x12, #(8 * \slot)]
+.endm
+
+.macro SWEET_SMP_MARK_ENTRY
+	mrs		x9, MPIDR_EL1
+	and		x10, x9, #0xf
+	ubfx	x11, x9, #8, #4
+	orr		x10, x10, x11, lsl #4
+	adrp	x12, EXT(sweet_smp_mark)@page
+	add		x12, x12, EXT(sweet_smp_mark)@pageoff
+	add		x12, x12, x10, lsl #6
+	mov		x11, #1
+	str		x11, [x12]			/* slot 0: entry reached */
+	mrs		x11, CurrentEL
+	lsr		x11, x11, #2
+	str		x11, [x12, #40]			/* slot 5: EL at entry */
+	str		x0, [x12, #48]			/* slot 6: PSCI context */
+.endm
+#endif /* SWEET */
