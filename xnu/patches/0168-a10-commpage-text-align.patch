+	 * No free VM-page-aligned slot is a hard error, not a silent
+	 * mis-mapping.
+	 */
+	if (commpage_text_va == 0 || (commpage_text_va & (PAGE_SIZE - 1))) {
+		panic("%s: no free VM-page-aligned commpage text slot "
+		    "(num_slots=%d, ptes_per_page=%d)", __func__, num_slots, ptes_per_page);
+	}
 
 	// Assert that this is empty
 	__assert_only pt_entry_t *ptep = pmap_pte(commpage_pmap_default, commpage_text_va);
@@ -10931,7 +10988,9 @@ pmap_create_commpages(vm_map_address_t *kernel_data_addr, vm_map_address_t *kern
 
