+	 */
+	int ptes_per_page = (int)(PAGE_SIZE >> pt_attr_leaf_shift(pt_attr));
+	int num_slots = num_ptes / ptes_per_page;
+	const vm_map_address_t l3_base =
+	    _COMM_PAGE64_BASE_ADDRESS & ~(vm_map_address_t)pt_attr_leaf_index_mask(pt_attr);
+	const unsigned int leaf_shift = pt_attr_leaf_shift(pt_attr);
+
+	assert(ptes_per_page > 0);
+	assert((num_ptes % ptes_per_page) == 0);
+	assert(num_slots > 0);
+
 	vm_map_address_t commpage_text_va = 0;
 
-	do {
-		int text_leaf_index = random() % num_ptes;
