diff --git a/bsd/dev/sweet_sample.c b/bsd/dev/sweet_sample.c
index b40eccd..a5d9299 100644
--- a/bsd/dev/sweet_sample.c
+++ b/bsd/dev/sweet_sample.c
@@ -10,7 +10,9 @@
  * with tools/sweet-crash.py). A thread blocked in a syscall shows the
  * syscall stub in pc and its caller in lr/bt.
  *
- * First sample 90 s after start, then every 120 s, 40 samples at most.
+ * First sample 30 s after start, then every 60 s, 40 samples at most.
+ * Each sample also prints the pid/ppid of every process, so the process
+ * dependency chain can be reconstructed from the log.
  */
 #include <sys/param.h>
 #include <sys/systm.h>
@@ -51,6 +53,7 @@ sweet_sample_proc(proc_t p, __unused void *arg)
 {
 	char name[32];
 	proc_name(proc_pid(p), name, sizeof(name));
+	printf("SMP P %s[%d] ppid %d\n", name, proc_pid(p), p->p_ppid);
 	if (sweet_sample_wanted(name)) {
 		task_t task = proc_task(p);
 		if (task != TASK_NULL) {
@@ -70,11 +73,11 @@ sweet_sample_thread(__unused void *arg, __unused wait_result_t wr)
 	if (sweet_sample_names[0] == '-') {
 		return;
 	}
-	(void)tsleep(&chan, PZERO, "sweetsmp", 90 * hz);
+	(void)tsleep(&chan, PZERO, "sweetsmp", 30 * hz);
 	for (int i = 0; i < 40; i++) {
 		printf("SMP --- sample %d\n", i);
 		proc_iterate(PROC_ALLPROCLIST, sweet_sample_proc, NULL, NULL, NULL);
-		(void)tsleep(&chan, PZERO, "sweetsmp", 120 * hz);
+		(void)tsleep(&chan, PZERO, "sweetsmp", 60 * hz);
 	}
 }
 
