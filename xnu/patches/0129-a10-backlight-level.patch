--- a/bsd/dev/a10_battery.c
+++ b/bsd/dev/a10_battery.c
@@ -104,6 +104,34 @@ static bool a10_charger_ok;
 static bool a10_backlight_ready;
 static bool a10_backlight_on = true;
 static int a10_backlight_mode = -1;	/* a10bl: 0 off, 1 full init, 2 enable only */
+static int a10_backlight_level = -1;	/* a10bl_level: 0..255 (LM3632 reg 0x05) */
+
+/*
+ * The LM3632 takes the backlight brightness in register 0x05 (0x00 = off,
+ * 0xff = full).  The port has no IODisplay, so iOS cannot drive a slider;
+ * the level is taken from the boot arguments instead.
+ */
+static int
+a10_backlight_get_level(void)
+{
+	int level = 0xff;
+
+	if (a10_backlight_level >= 0) {
+		return a10_backlight_level;
+	}
+	if (!PE_parse_boot_argn("a10bl_level", &level, sizeof(level))) {
+		level = 0xff;
+	}
+	if (level < 0) {
+		level = 0;
+	}
+	if (level > 0xff) {
+		level = 0xff;
+	}
+	a10_backlight_level = level;
+	printf("A10 BATTERY: backlight level %d/255\n", level);
+	return level;
+}
 
